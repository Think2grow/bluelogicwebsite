---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import { getFAQSchema, getBreadcrumbSchema } from "../utils/schema";
import { PRICES, usd } from "../data/offer";

const priceRange = `${usd(PRICES.softener)} to $19,999`;

export const prerender = true;

const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "Kinetico is known for softening. Does Blue Logic do softening too?",
    answer: "Yes. Blue Logic Filtration softens and filters your water in one tank. You get soft water that ends scale and spots, plus chlorine and chloramine taste and odor gone at every tap and sediment and rust filtered out. Every Filtration system includes an under-sink reverse osmosis system at the kitchen tap, and the Blue Logic Purification System adds whole-home reverse osmosis, which removes or reduces lead, arsenic, PFAS, nitrates and fluoride at every tap. If hardness is your only concern, the Blue Logic Softener is our softening-only option.",
  },
  {
    question: "Does it matter how a softener regenerates?",
    answer: "How a system regenerates is worth understanding, and Blue Logic systems regenerate on a water meter rather than a timer, so they recharge based on how much water you actually use. But for most Utah homeowners the more important question is what the system removes from your water. Softening on its own, however it regenerates, does not address arsenic, PFAS or disinfection byproducts.",
  },
  {
    question: "How do I know if I need RO or if a softener is enough?",
    answer: "A free in-home water test answers this directly. It measures your water's hardness and TDS, and your specialist walks you through contaminant data for your city's water source. If your city's water shows arsenic or PFAS in the EWG Tap Water Database (for example, Lehi at 484x and Draper at 450x the EWG arsenic guideline), softening alone won't address those. The test removes the guesswork.",
  },
  {
    question: "Can I bring a Kinetico quote to compare?",
    answer: "Yes. Bring any written quote to your free Blue Logic water test and we'll compare it with ours line by line: what each system treats, the full installed price, the warranty, and what ongoing service costs.",
  },
  {
    question: "Does Blue Logic require a service contract?",
    answer: "No. Blue Logic does not require an ongoing service contract. Annual maintenance, which covers filter changes and a general system check, is standard and scheduled for you. Visits outside scheduled maintenance carry a $129 service call fee.",
  },
];

const schemas = [
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Blue Logic vs. Kinetico Utah", url: "/blue-logic-vs-kinetico-utah/" },
  ]),
];
---

<Layout
  title="Blue Logic vs. Kinetico Utah | Softening Alone Isn't Enough"
  description="Considering a Kinetico softener? Utah water can carry arsenic, PFAS, and disinfection byproducts that softening doesn't touch. See how Blue Logic filtration and whole-home RO compare. Free water test."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Utah Water Treatment · Comparison Guide
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Kinetico Is Great at Softening.<br />But Utah Water Needs More.
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        If Kinetico is on your list, you're probably focused on water softening, and if your only
        concern is scale and hardness, a softener may be enough. But if your water has arsenic,
        PFAS, or disinfection byproducts, and many Utah cities' water does, softening alone won't
        address those contaminants.
      </p>
    </div>
  </section>

  <section class="bg-primary/5 border-y border-primary/20 py-6 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-muted-foreground text-center">
        <strong class="text-foreground">What this page covers:</strong> Blue Logic's verified specs and how softening compares to whole-home filtration for Utah's specific water problems.
        We make no claims about Kinetico's products, pricing or terms. Bring any written quote to your free water test and we'll compare it with ours.
      </p>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="mb-12">
        <h2 class="text-3xl font-serif text-center mb-8 text-foreground">
          What Softening Fixes, and What It Doesn't
        </h2>
        <p class="text-muted-foreground text-center max-w-2xl mx-auto mb-8">
          Water softening is designed for one job: removing calcium and magnesium (hardness minerals).
          It does that well. But Utah's water contains additional contaminants that softeners were never built to remove.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-border">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-card border-b border-border">
                <th class="text-left p-4 font-semibold text-foreground">Water Problem in Utah</th>
                <th class="p-4 font-semibold text-foreground text-center">Softener Only</th>
                <th class="p-4 font-semibold text-primary text-center">Whole-Home Filtration + RO</th>
              </tr>
            </thead>
            <tbody>
              {[
                { problem: "Scale and hardness (calcium/magnesium)", softener: "✓ Resolved", ro: "✓ Resolved" },
                { problem: "Chlorine taste and odor", softener: "✗ Not addressed", ro: "✓ Removed" },
                { problem: "Arsenic (elevated in Lehi, Draper, SLC)", softener: "✗ Not removed", ro: "✓ Reduced by RO membrane" },
                { problem: "PFAS (detected in Salt Lake City)", softener: "✗ Not removed", ro: "✓ Reduced by RO membrane" },
                { problem: "Haloacetic acid disinfection byproducts", softener: "✗ Not addressed", ro: "✓ Addressed" },
                { problem: "Iron and manganese staining", softener: "Partial", ro: "✓ Addressed (assessed at your water test)" },
              ].map((row, i) => (
                <tr class={i % 2 === 0 ? "bg-background" : "bg-card"}>
                  <td class="p-4 text-muted-foreground">{row.problem}</td>
                  <td class="p-4 text-center text-muted-foreground">{row.softener}</td>
                  <td class="p-4 text-center font-medium text-primary">{row.ro}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-muted-foreground text-center mt-4">
          Arsenic and PFAS data from the EWG Tap Water Database.
        </p>
      </div>

      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">Blue Logic's Verified System Specs</h2>
      <p class="text-sm text-muted-foreground text-center mb-8">Ask Kinetico the same questions, then compare written answers.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
        {[
          { label: "Softening", value: "Yes", note: "Blue Logic Filtration softens and filters in one tank, regenerating on a water meter." },
          { label: "Filtration", value: "Yes", note: "Chlorine and chloramine taste and odor gone at every tap; sediment and rust filtered out." },
          { label: "Reverse osmosis", value: "Included or whole-home", note: "Under-sink RO comes with Filtration; the Purification System adds whole-home RO for lead, arsenic, PFAS and more." },
          { label: "System price range", value: priceRange, note: "Out the door: standard installation and tax included, confirmed in writing at your free water test." },
          { label: "Storage tank materials", value: "NSF/ANSI and FDA compliant", note: "The Purification System stores purified water in a 165-gallon food-grade tank built from NSF/ANSI and FDA compliant materials." },
          { label: "Warranty", value: "5 years on defects", note: "Covers defects in materials and workmanship; consumables such as filters, RO membranes and salt are excluded. Installation workmanship is covered for 12 months." },
          { label: "Service contract required", value: "No", note: "Annual maintenance (filter changes and a system check) is standard and scheduled for you. No ongoing service contract." },
          { label: "Financing", value: "Pinnacle Finance", note: "For qualifying homeowners, subject to credit approval. Checking eligibility is a soft credit inquiry." },
        ].map((item) => (
          <div class="spec-card">
            <div class="flex justify-between items-start gap-4 mb-2">
              <span class="font-semibold text-foreground">{item.label}</span>
              <span class="text-primary font-bold shrink-0">{item.value}</span>
            </div>
            <p class="text-xs text-muted-foreground">{item.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews compact={true} heading="What Utah Homeowners Say About Blue Logic" />
    </div>
  </section>

  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">
        Find Out What's Actually in Your Water
      </h2>
      <p class="text-muted-foreground text-center mb-10">
        A free in-home water test measures your home's specific water profile: hardness, TDS,
        and key contaminants. That determines whether softening alone is enough, or whether you
        need filtration and RO. No obligation, no pressure.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .hero-gradient {
    @apply bg-linear-to-br from-background to-card;
  }

  .spec-card {
    @apply bg-card p-5 rounded-xl border border-border;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
