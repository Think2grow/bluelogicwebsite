---
// Temporary photo picker for Scott and Jared (2026-11-13). Password gated,
// noindex, excluded from robots.txt and the sitemap. Delete this page, its
// manifest (src/data/photo-review.json) and public/review-* once photos are chosen.
import manifest from "../data/photo-review.json";

export const prerender = false;

// Each password identifies one person (Scott, 2026-11-13). Picks are saved
// per person in the PHOTO_PICKS KV namespace (keys picks:Scott / picks:Jared).
const PEOPLE: Record<string, { password: string; token: string }> = {
  Scott: { password: "Scott152", token: "857cbea9ee6ab11e10d1f068f443a3cf" },
  Jared: { password: "bluelogic2026", token: "b885d1af3b749bbb0b71357d365c06b1" },
};
const COOKIE = "bl_photo_review";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
Astro.response.headers.set("Cache-Control", "no-store");

const kv = (Astro.locals as any).runtime?.env?.PHOTO_PICKS as KVNamespace | undefined;
const tokenOf = Astro.cookies.get(COOKIE)?.value;
let who = Object.keys(PEOPLE).find((n) => PEOPLE[n].token === tokenOf);
const readPicks = async (name: string): Promise<string[]> => {
  try { return JSON.parse((await kv?.get("picks:" + name)) || "[]"); } catch { return []; }
};

let wrong = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.has("password")) {
    const name = Object.keys(PEOPLE).find((n) => PEOPLE[n].password === form.get("password"));
    if (name) {
      Astro.cookies.set(COOKIE, PEOPLE[name].token, { path: "/", httpOnly: true, secure: import.meta.env.PROD, sameSite: "lax", maxAge: 60 * 60 * 24 * 14 });
      return Astro.redirect("/photos/", 303);
    }
    wrong = true;
  } else if (who && form.has("toggle")) {
    const id = String(form.get("toggle"));
    const picks = await readPicks(who);
    const i = picks.indexOf(id);
    if (i > -1) picks.splice(i, 1); else if (/^P\d{3}$/.test(id)) picks.push(id);
    picks.sort();
    await kv?.put("picks:" + who, JSON.stringify(picks), { metadata: { updated: new Date().toISOString() } });
    return new Response(JSON.stringify({ picks }), { headers: { "content-type": "application/json", "cache-control": "no-store", "x-robots-tag": "noindex" } });
  } else if (form.has("logout")) {
    Astro.cookies.delete(COOKIE, { path: "/" });
    return Astro.redirect("/photos/", 303);
  }
}
const authed = !!who;
const other = who === "Scott" ? "Jared" : "Scott";
const myPicks = who ? await readPicks(who) : [];
const otherPicks = who ? await readPicks(other) : [];

const groups: { name: string; items: typeof manifest.items }[] = [];
for (const it of manifest.items) {
  let g = groups.find((x) => x.name === it.group);
  if (!g) groups.push((g = { name: it.group, items: [] }));
  g.items.push(it);
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>Photo Picks</title>
  <style>
    :root { --bg:#f6f7f9; --card:#fff; --ink:#111827; --muted:#6b7280; --line:#e5e7eb; --accent:#2f8fae; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: Inter, system-ui, sans-serif; background:var(--bg); color:var(--ink); }
    header { position:sticky; top:0; z-index:5; background:#fff; border-bottom:1px solid var(--line); padding:12px 16px; display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
    header h1 { font-size:18px; margin:0 12px 0 0; }
    select, button, input { font:inherit; padding:8px 12px; border-radius:8px; border:1px solid var(--line); background:#fff; }
    button.primary { background:var(--accent); color:#fff; border-color:var(--accent); cursor:pointer; }
    .count { color:var(--muted); font-size:14px; }
    main { padding:16px; max-width:1400px; margin:0 auto; }
    h2 { font-size:17px; margin:28px 0 10px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); gap:12px; }
    .ph { background:var(--card); border:2px solid var(--line); border-radius:12px; overflow:hidden; cursor:pointer; position:relative; }
    .ph img { width:100%; aspect-ratio:3/4; object-fit:cover; display:block; background:#ddd; }
    .ph .meta { padding:6px 8px; font-size:12px; color:var(--muted); display:flex; justify-content:space-between; gap:6px; }
    .ph .meta a { color:var(--accent); text-decoration:none; white-space:nowrap; }
    .ph.picked { border-color:var(--accent); box-shadow:0 0 0 3px rgba(47,143,174,.35); }
    .ph .badge { display:none; position:absolute; top:8px; right:8px; background:var(--accent); color:#fff; font-size:12px; font-weight:600; padding:4px 8px; border-radius:999px; }
    .ph.picked .badge { display:block; }
    .ph .other { position:absolute; top:8px; left:8px; background:rgba(17,24,39,.75); color:#fff; font-size:12px; padding:4px 8px; border-radius:999px; }
    .login { max-width:340px; margin:15vh auto; background:#fff; padding:24px; border-radius:12px; border:1px solid var(--line); }
    .login input { width:100%; margin:12px 0; }
    .err { color:#b91c1c; font-size:14px; }
    .note { color:var(--muted); font-size:14px; margin:4px 0 0; }
    #toast { position:fixed; bottom:16px; left:50%; transform:translateX(-50%); background:#111827; color:#fff; padding:10px 16px; border-radius:8px; display:none; }
  </style>
</head>
<body>
{!authed ? (
  <form class="login" method="post">
    <strong>Blue Logic photo picks</strong>
    <input type="password" name="password" placeholder="Password" autofocus />
    {wrong && <p class="err">That password did not match.</p>}
    <button class="primary" type="submit">Open</button>
  </form>
) : (
  <>
    <header>
      <h1>Photo Picks</h1>
      <span>Picking as <strong>{who}</strong></span>
      <span class="count" id="count">{myPicks.length} picked</span>
      <button id="only">Show only my picks</button>
      <form method="post" style="margin:0"><button name="logout" value="1">Sign out</button></form>
    </header>
    <main>
      <p class="note">Tap a photo to pick it. "Full" opens the large version. Your picks save automatically, so you can come back any time. A gray tag shows what {other} picked.</p>
      {groups.map((g) => (
        <section>
          <h2>{g.name} ({g.items.length})</h2>
          <div class="grid">
            {g.items.map((it) => (
              <div class:list={["ph", myPicks.includes(it.id) && "picked"]} data-id={it.id}>
                <span class="badge">Picked</span>
                {otherPicks.includes(it.id) && <span class="other">{other} picked</span>}
                <img src={it.thumb} alt={it.label} loading="lazy" />
                <div class="meta"><span>{it.id} · {it.label}</span><a href={it.full} target="_blank" rel="noopener">Full</a></div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </main>
    <div id="toast"></div>
    <script is:inline>
      (function () {
        var onlyMine = false;
        function count() { document.getElementById("count").textContent = document.querySelectorAll(".ph.picked").length + " picked"; }
        function filter() { document.querySelectorAll(".ph").forEach(function (el) { el.style.display = onlyMine && !el.classList.contains("picked") ? "none" : ""; }); }
        var t = document.getElementById("toast");
        function toast(m) { t.textContent = m; t.style.display = "block"; setTimeout(function () { t.style.display = "none"; }, 2500); }
        document.querySelectorAll(".ph").forEach(function (el) {
          el.addEventListener("click", function (e) {
            if (e.target.tagName === "A") return;
            el.classList.toggle("picked"); count(); filter();
            var fd = new FormData(); fd.append("toggle", el.dataset.id);
            fetch("/photos/", { method: "POST", body: fd, credentials: "same-origin" })
              .then(function (r) { if (!r.ok) throw 0; return r.json(); })
              .then(function (d) { document.querySelectorAll(".ph").forEach(function (x) { x.classList.toggle("picked", d.picks.indexOf(x.dataset.id) > -1); }); count(); filter(); })
              .catch(function () { el.classList.toggle("picked"); count(); filter(); toast("Did not save. Check your connection and tap again."); });
          });
        });
        document.getElementById("only").addEventListener("click", function () { onlyMine = !onlyMine; this.textContent = onlyMine ? "Show all" : "Show only my picks"; filter(); });
      })();
    </script>
  </>
)}
</body>
</html>
