---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import { getFAQSchema, getBreadcrumbSchema } from "../utils/schema";
import { PRICES, usd } from "../data/offer";

const priceRange = `${usd(PRICES.softener)} to $19,999`;

export const prerender = true;
const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "Alta Water is also a local Utah company. What makes Blue Logic different?",
    answer: "Compare any two local companies on the same terms: who designs and who physically performs your installation, the full installed cost in writing, whether a service contract is required, what the warranty covers, and what documentation backs any certification claim. Blue Logic is family-owned: co-owner Jared designs your system and oversees installation by our professional installation partner, and you call Blue Logic directly for support.",
  },
  {
    question: "Who do I call if something needs service three years after installation?",
    answer: "With Blue Logic, you call Blue Logic directly. We try to solve the issue by phone first, and if we can't, we send a technician. Ask any provider the same question: who do you call for service after the first year, and how is it handled?",
  },
  {
    question: "How do I verify the quality of a Blue Logic system?",
    answer: "Ask for the details in writing at your free water test: what each system treats, the warranty terms, and component documentation. The Purification System's storage tank is built from NSF/ANSI and FDA compliant materials. You can also read Blue Logic's Google Business Profile reviews, which are publicly visible.",
  },
  {
    question: "Can I bring an Alta Water quote to compare?",
    answer: "Yes. Bring any written quote to your free Blue Logic water test and we'll compare it with ours line by line: what each system treats, the full installed price, the warranty, and what ongoing service costs.",
  },
  {
    question: "Does Blue Logic offer financing?",
    answer: "Yes. Financing is available through Pinnacle Finance for qualifying homeowners, subject to credit approval. Checking your eligibility is a soft credit inquiry that does not affect your credit score. Ask about current financing options at your free water test.",
  },
];

const schemas = [
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Blue Logic vs. Alta Water Utah", url: "/blue-logic-vs-alta-water-utah/" },
  ]),
];
---

<Layout
  title="Blue Logic vs. Alta Water Utah | Who Does the Work Matters"
  description="Both Blue Logic and Alta Water serve Utah homeowners. Here's what to ask about who installs your system, who services it long-term, and what you actually own. Free water test."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Utah Water Treatment · Comparison Guide
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        The Company Behind the Quote Matters as Much as the Quote Itself
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        If you're comparing Alta Water and Blue Logic, compare more than the price: who designs
        and installs the system, what the company stands behind in writing, and who you call when
        you need them three years from now.
      </p>
    </div>
  </section>

  <section class="bg-primary/5 border-y border-primary/20 py-6 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-muted-foreground text-center">
        <strong class="text-foreground">What this page covers:</strong> Blue Logic's verified specs and what to ask any local provider about accountability, installation, and long-term service.
        We make no claims about Alta Water's pricing or terms. Bring any written quote to your free water test and we'll compare it with ours.
      </p>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="mb-12">
        <h2 class="text-3xl font-serif text-center mb-8 text-foreground">
          Questions About Accountability That Most Homeowners Don't Think to Ask
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            {
              q: "Who physically installs your system?",
              context: "The person who sells you a system and the people who install it may be different. Ask who does the work and who is accountable for it.",
              blueLogic: "Co-owner Jared designs your system and oversees installation by our professional installation partner.",
            },
            {
              q: "Who do you call for service after year one?",
              context: "Know your service chain before you need it: who answers, how issues are handled, and what a service visit costs.",
              blueLogic: "Call Blue Logic directly. We troubleshoot by phone first and send a technician if needed.",
            },
            {
              q: "What does the warranty cover, in writing?",
              context: "Warranty length matters less than what it covers. Ask what is covered, what counts as a consumable, and how long installation workmanship is covered.",
              blueLogic: "5 years on defects in materials and workmanship; consumables such as filters, RO membranes and salt excluded; 12 months on installation workmanship.",
            },
            {
              q: "What is the installed price in writing, all-in?",
              context: "Quotes sometimes separate equipment from labor or exclude components like tanks and pumps. Always ask for a total installed price, in writing, before comparing.",
              blueLogic: `${priceRange} out the door, with standard installation and tax included. Confirmed in writing at the water test.`,
            },
          ].map((item) => (
            <div class="accountability-card">
              <h3 class="font-semibold text-foreground mb-2">{item.q}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed mb-3">{item.context}</p>
              <div class="blue-logic-note">
                <span class="text-xs font-semibold text-primary uppercase tracking-wide">Blue Logic: </span>
                <span class="text-sm text-muted-foreground">{item.blueLogic}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="how-it-works bg-card rounded-2xl border border-border p-6 md:p-8 mb-12">
        <h2 class="text-2xl font-serif mb-6 text-foreground">How Blue Logic Works, From First Call to Long-Term Service</h2>
        <div class="space-y-4">
          {[
            { step: "1", title: "Free in-home water test", desc: "A Blue Logic specialist visits your home, tests your water for hardness and TDS, walks you through the contaminant data for your city, and shows you the results on the spot." },
            { step: "2", title: "Custom system recommendation", desc: "Based on your specific water profile and home layout, we recommend the right system, not a one-size-fits-all package." },
            { step: "3", title: "Written quote", desc: "You receive a full written quote covering all components and labor. Take it home and compare it to any other quote you have." },
            { step: "4", title: "Installation day", desc: "Our professional installation partner installs your system, overseen by Blue Logic, on a timeline confirmed with you in advance." },
            { step: "5", title: "Annual maintenance", desc: "Scheduled for you. Annual maintenance covers filter changes and a general system check to confirm everything is performing." },
          ].map((item) => (
            <div class="flex gap-4">
              <span class="step-number">{item.step}</span>
              <div>
                <div class="font-semibold text-foreground">{item.title}</div>
                <div class="text-sm text-muted-foreground">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">Blue Logic's Verified System Specs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
        {[
          { label: "Who is accountable", value: "Owner-led", note: "Co-owner Jared designs your system and oversees installation by our professional installation partner." },
          { label: "System price range", value: priceRange, note: "Out the door: standard installation and tax included, confirmed in writing at your free water test." },
          { label: "Storage tank materials", value: "NSF/ANSI and FDA compliant", note: "The Purification System stores purified water in a 165-gallon food-grade tank built from NSF/ANSI and FDA compliant materials." },
          { label: "Warranty", value: "5 years on defects", note: "Covers defects in materials and workmanship; consumables such as filters, RO membranes and salt are excluded. Installation workmanship is covered for 12 months." },
          { label: "Service contract required", value: "No", note: "Annual maintenance (filter changes and a system check) is standard and scheduled for you. No ongoing service contract." },
          { label: "Financing", value: "Pinnacle Finance", note: "For qualifying homeowners, subject to credit approval. Checking eligibility is a soft credit inquiry." },
        ].map((item) => (
          <div class="spec-card">
            <div class="flex justify-between items-start gap-4 mb-2">
              <span class="font-semibold text-foreground">{item.label}</span>
              <span class="text-primary font-bold shrink-0">{item.value}</span>
            </div>
            <p class="text-xs text-muted-foreground">{item.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews compact={true} heading="What Utah Homeowners Say About Blue Logic" />
    </div>
  </section>

  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">
        Get a Quote. Compare.
      </h2>
      <p class="text-muted-foreground text-center mb-10">
        Blue Logic's free water test is how the process starts: we visit your home, test
        your water on-site, and give you a transparent written quote. If you have an Alta
        Water quote, bring it and we'll compare the two with you. Then you have both quotes
        and make the call yourself.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .hero-gradient {
    @apply bg-linear-to-br from-background to-card;
  }

  .accountability-card {
    @apply bg-card p-6 rounded-xl border border-border;
  }

  .blue-logic-note {
    @apply bg-primary/5 border border-primary/20 rounded-lg px-4 py-2;
  }

  .step-number {
    @apply w-8 h-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center shrink-0 mt-0.5;
  }

  .spec-card {
    @apply bg-card p-5 rounded-xl border border-border;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
