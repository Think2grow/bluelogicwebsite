---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import { getServiceSchema, getFAQSchema, getBreadcrumbSchema, getAggregateRatingSchema } from "../utils/schema";
import { Image } from "astro:assets";
import filtrationInstallImg from "../assets/real/installs/filtration-beside-water-heater.jpg";
import underSinkRoImg from "../assets/real/installs/under-sink-ro-install.jpg";
import { OFFER_HEADLINE, OFFER_SUBHEAD, OFFER_DISCLOSURE, offerActive, WARRANTY, PRICE_NOTE } from "../data/offer";

export const prerender = true;

const showOffer = offerActive();

const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "What does Blue Logic Filtration actually do?",
    answer: "Blue Logic Filtration softens and filters all the water coming into your home in one tank. You get soft water that stops scale on fixtures and inside appliances, chlorine and chloramine taste and odor gone at every tap, and sediment and rust filtered out before they reach your plumbing. Every Filtration system also includes an under-sink reverse osmosis system for purified drinking water at the kitchen tap. Your free water test shows which concerns matter most for your home's water.",
  },
  {
    question: "Does the Filtration system use filter cartridges?",
    answer: "No. The whole-home treatment happens inside one self-cleaning tank that regenerates automatically based on how much water your home uses, so there are no whole-home cartridges to swap. The only filters are in the under-sink reverse osmosis system at the kitchen tap, and those are replaced at your annual maintenance visit.",
  },
  {
    question: "How is whole-home filtration different from a regular water softener?",
    answer: "A water softener treats hardness: the calcium and magnesium that cause scale, spots and that chalky feel. It does not filter the water, so chlorine taste and odor and sediment stay. Blue Logic Filtration softens the water and filters it in the same tank, and it adds an under-sink reverse osmosis system at the kitchen tap.",
  },
  {
    question: "How is whole-home filtration different from whole-home reverse osmosis?",
    answer: "Filtration gives you soft, filtered water at every tap and purified reverse osmosis water at the kitchen tap. The Blue Logic Purification System starts with the same Filtration tank, then adds whole-home reverse osmosis, a 165-gallon food-grade storage tank and a Grundfos SCALA2 constant-pressure pump, so every tap in the home runs purified water. The Filtration in front is what lets the reverse osmosis run at about 3 gallons of purified water for every 1 sent to drain. Our systems are modular, so you can start with Filtration and add reverse osmosis later.",
  },
  {
    question: "What maintenance does the filtration system require?",
    answer: "Day to day, you keep salt in the brine tank. Salt is easy to find at large local stores such as Costco and Walmart. Blue Logic handles annual maintenance, which includes new filters for the under-sink reverse osmosis system and a general system check.",
  },
  {
    question: "What is the warranty on the whole-home filtration system?",
    answer: `${WARRANTY} We're a local Utah company, here for the long term, not just the sale.`,
  },
  {
    question: "Do you offer financing for the filtration system?",
    answer: "Yes. Financing is provided by Pinnacle Finance to qualifying homeowners, subject to credit approval. Checking your eligibility is a soft credit inquiry that does not affect your credit score. See the current offer on this page for details.",
  },
  {
    question: "Is an under-sink reverse osmosis system included with Filtration?",
    answer: "Yes. Every Blue Logic Filtration system includes an under-sink reverse osmosis system with its own dedicated tap at the kitchen sink. It gives you purified drinking and cooking water at that tap, reducing contaminants such as lead, arsenic, fluoride, nitrates and PFAS, without upgrading to whole-home reverse osmosis.",
  },
];

const schemas = [
  getServiceSchema(
    `${siteUrl}/whole-home-water-filtration/`,
    "Whole-Home Water Filtration System Installation, Utah",
    "Blue Logic Filtration softens and filters every tap in the home in one self-cleaning tank: soft water, chlorine and chloramine taste and odor gone, sediment and rust filtered out. Includes an under-sink reverse osmosis system at the kitchen tap. Serving the Wasatch Front.",
  ),
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Whole-Home Water Filtration", url: "/whole-home-water-filtration/" },
  ]),
  getAggregateRatingSchema(`${siteUrl}/whole-home-water-filtration/`),
];
---

<Layout
  title="Whole Home Water Filtration Utah | Blue Logic Water"
  description="Blue Logic Filtration: whole-home softening and filtration in one self-cleaning tank, plus an under-sink RO at the kitchen tap. Free water test on the Wasatch Front."
  schema={schemas}
>
  <!-- Hero -->
  <section class="hero-gradient py-20 md:py-28 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Wasatch Front · Under-Sink RO Included
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Whole-Home Water Filtration for Utah Homes
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto mb-8 leading-relaxed">
        Blue Logic Filtration softens and filters the water for your whole home in one
        self-cleaning tank. Soft water, no chlorine or chloramine taste or smell, and sediment
        and rust filtered out at every tap, plus purified reverse osmosis water at the kitchen
        sink.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/free-water-test/"
          class="inline-block bg-primary text-primary-foreground font-semibold text-lg px-8 py-4 rounded-full shadow-lg hover:bg-primary/90 transition-all"
        >
          Schedule Free Water Test →
        </a>
        <a
          href="tel:+18019802583"
          class="inline-block border-2 border-primary text-primary font-semibold text-lg px-8 py-4 rounded-full hover:bg-primary/5 transition-all"
        >
          Call (801) 980-2583
        </a>
      </div>
    </div>
  </section>

  <!-- Offer Banner -->
  {showOffer && (
    <section class="bg-primary/10 border-y border-primary/20 py-6 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-2">Current Offer</p>
        <p class="text-xl md:text-2xl font-serif text-foreground mb-1">{OFFER_HEADLINE}</p>
        <p class="text-muted-foreground mb-3">
          {OFFER_SUBHEAD}{" "}
          <a href="/free-water-test/" class="text-primary underline hover:no-underline">Schedule free water test</a>
        </p>
        <p class="text-xs text-muted-foreground leading-relaxed">{OFFER_DISCLOSURE}</p>
      </div>
    </section>
  )}

  <!-- One Tank, Whole Home -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            One Tank. One Installation. Every Tap.
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">
            Utah's water brings more than one problem: hard water that leaves scale, chlorine
            and chloramine from municipal treatment, and sediment and rust. A softener alone
            only handles the first.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">
            Blue Logic Filtration handles all of them in a single tank, installed where your
            water enters the home. It cleans itself automatically based on how much water you
            use, so there are no whole-home cartridges to change. The result is softer, cleaner,
            better-tasting water from every tap, shower and appliance in your home.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed">
            It is also the foundation of the Blue Logic Purification System, so if you start
            with Filtration and want whole-home reverse osmosis later, the foundation is
            already in place.
          </p>
        </div>
        <div class="max-w-md mx-auto w-full">
          <Image
            src={filtrationInstallImg}
            alt="Blue Logic Whole-Home Filtration tank with its digital control valve, installed beside the water heater and brine tank in a Utah home"
            class="rounded-2xl shadow-2xl w-full object-cover object-top aspect-3/4"
            widths={[400, 600, 900]}
            sizes="(max-width: 1024px) 100vw, 448px"
            quality={70}
          />
          <p class="text-sm text-muted-foreground text-center mt-4 italic">
            Blue Logic Filtration installed in a customer's home
          </p>
        </div>
      </div>

      <!-- What Filtration Takes Care Of -->
      <h3 class="text-2xl font-serif text-center mb-8 text-foreground">What Blue Logic Filtration Takes Care Of</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="layer-card">
          <div class="layer-number">1</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Soft Water</h4>
            <p class="text-sm text-muted-foreground">Removes the hardness minerals behind white spots, scale on fixtures and buildup inside appliances.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">2</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Chlorine and Chloramine</h4>
            <p class="text-sm text-muted-foreground">Takes out the chlorine and chloramine taste and odor from city water at every tap, including showers and baths.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">3</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Sediment and Rust</h4>
            <p class="text-sm text-muted-foreground">Filters out fine sand, rust and other particles for visibly clear water that is easier on plumbing and clothing.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">4</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Purified Water at the Kitchen Tap</h4>
            <p class="text-sm text-muted-foreground">An under-sink reverse osmosis system with its own dedicated tap is included, for purified drinking and cooking water.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">5</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Self-Cleaning Tank</h4>
            <p class="text-sm text-muted-foreground">The tank regenerates automatically based on your water use. You keep salt in the brine tank; we handle annual maintenance.</p>
          </div>
        </div>
        <div class="layer-card">
          <div class="layer-number">6</div>
          <div>
            <h4 class="font-semibold text-foreground mb-1">Ready to Upgrade</h4>
            <p class="text-sm text-muted-foreground">Filtration is the first stage of whole-home reverse osmosis, so you can add purification for every tap later.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kitchen Tap RO -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <Image
          src={underSinkRoImg}
          alt="Installer fitting an under-sink reverse osmosis system in a customer's kitchen sink cabinet"
          class="rounded-2xl shadow-2xl w-full object-cover aspect-4/3"
          widths={[400, 600, 900]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          quality={70}
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
          Purified Drinking Water, Included
        </h2>
        <p class="text-lg text-muted-foreground leading-relaxed mb-4">
          Every Blue Logic Filtration system comes with an under-sink reverse osmosis system
          and its own dedicated tap at the kitchen sink. It needs no storage tank and plugs into
          a standard outlet.
        </p>
        <p class="text-lg text-muted-foreground leading-relaxed">
          Reverse osmosis reduces what filtration alone cannot, including dissolved solids,
          lead, arsenic, fluoride, nitrates and PFAS, so the water you drink and cook with is
          purified, not just filtered.
        </p>
      </div>
    </div>
  </section>

  <!-- What You'll Notice -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        What Utah Homeowners Notice After Installation
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        The changes are practical and immediate, not abstract.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">No more chlorine smell or taste</h3>
          <p class="text-sm text-muted-foreground">Chlorine and chloramine are taken out of all the water entering your home, including the shower and bath water you breathe in and that touches your skin.</p>
        </div>
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">Scale stops building up</h3>
          <p class="text-sm text-muted-foreground">Softened water means no new mineral deposits on showerheads, faucets, glass shower doors, or inside your appliances.</p>
        </div>
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">Better-tasting water everywhere</h3>
          <p class="text-sm text-muted-foreground">Water tastes clean and fresh rather than chlorinated or chalky. At the kitchen tap, reverse osmosis gives you purified water for drinking, coffee, tea and cooking.</p>
        </div>
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">Skin and hair feel different</h3>
          <p class="text-sm text-muted-foreground">Soft water without chlorine is easier on skin and hair, so showers leave you feeling clean rather than dry.</p>
        </div>
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">Appliances are protected</h3>
          <p class="text-sm text-muted-foreground">Water heaters, dishwashers and washing machines all run on soft, filtered water, without the scale that builds up inside them on hard water.</p>
        </div>
        <div class="notice-card">
          <h3 class="font-semibold text-foreground mb-2">Dishes come out clean</h3>
          <p class="text-sm text-muted-foreground">Soft water helps soap and detergent work better and leaves dishes and glassware clean, not chalky.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing and Financing -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Transparent Pricing and Financing
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        Blue Logic systems range from $2,999 to $19,999 depending on the system selected and your
        home's configuration. {PRICE_NOTE} Your exact price is confirmed at your free water test.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="pricing-card">
          <h3 class="font-semibold text-foreground mb-2">Transparent Quotes</h3>
          <p class="text-sm text-muted-foreground">Your out-the-door price, installation and tax included, is confirmed at your free water test. Any non-standard work is discussed before it is done.</p>
        </div>
        <div class="pricing-card border-primary bg-primary/5">
          <h3 class="font-semibold text-foreground mb-2">Financing Available</h3>
          <p class="text-sm text-muted-foreground">Financing through Pinnacle Finance for qualifying homeowners, subject to credit approval. Checking eligibility is a soft credit inquiry.</p>
        </div>
        <div class="pricing-card">
          <h3 class="font-semibold text-foreground mb-2">5-Year Warranty</h3>
          <p class="text-sm text-muted-foreground">Covers defects in materials and workmanship for 5 years, plus 12 months on installation workmanship. Consumables such as filters, RO membranes and salt are not covered.</p>
        </div>
      </div>
      <div class="text-center">
        <a
          href="/free-water-test/"
          class="inline-block bg-primary text-primary-foreground font-semibold text-lg px-8 py-4 rounded-full shadow hover:bg-primary/90 transition-all"
        >
          Get Your Free Quote →
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + Service Area -->
  <section class="bg-card py-12 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex flex-wrap justify-center gap-4 mb-6">
        <a href="/whole-home-reverse-osmosis-utah/" class="related-link">Upgrade to Whole-Home RO</a>
        <a href="/water-softener-utah/" class="related-link">Water Softener Utah</a>
        <a href="/water-softener-vs-whole-home-filtration/" class="related-link">Compare Options</a>
        <a href="/free-water-test/" class="related-link">Free Water Test</a>
      </div>
      <p class="text-muted-foreground text-sm">
        Serving: Salt Lake City · Provo · Orem · Lehi · Sandy · Draper · Ogden · Layton · Bountiful · American Fork · Spanish Fork · Springville and surrounding communities.
      </p>
    </div>
  </section>

  <!-- Form -->
  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Schedule Your Free Water Test
      </h2>
      <p class="text-lg text-muted-foreground text-center mb-10">
        A Blue Logic specialist will assess your home's water and walk you through whether Blue
        Logic Filtration, whole-home purification, or something else is right for your home.
        No cost, no obligation.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .layer-card {
    @apply flex gap-4 items-start bg-card p-5 rounded-xl border border-border;
  }

  .layer-number {
    @apply w-9 h-9 shrink-0 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-sm font-bold;
  }

  .notice-card {
    @apply bg-background p-6 rounded-xl border border-border border-l-4 border-l-primary;
  }

  .pricing-card {
    @apply bg-card p-6 rounded-xl border border-border text-center;
  }

  .related-link {
    @apply px-4 py-2 bg-background border border-border rounded-full text-sm text-primary font-medium hover:border-primary transition-colors;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
