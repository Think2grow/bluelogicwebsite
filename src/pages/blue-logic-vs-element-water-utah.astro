---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import { getFAQSchema, getBreadcrumbSchema } from "../utils/schema";
import { PRICES, usd } from "../data/offer";

const priceRange = "From about $1,000, customized to your home";

export const prerender = true;
const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "How do I fairly compare Blue Logic and Element Water?",
    answer: "Get written quotes from both, then compare them on the same terms: total installed cost including all components and labor, certification documentation (ask for specific standard numbers and which parts they cover), warranty terms and what's actually covered, service contract requirements and annual costs, and who physically performs the installation. Blue Logic will provide all of this at your free water test, in writing.",
  },
  {
    question: "What NSF certifications should I ask any water treatment company about?",
    answer: "Ask which standard each claim refers to and which specific parts it covers. For reverse osmosis, NSF/ANSI 58 covers point-of-use (under-sink) RO system performance and materials, and NSF/ANSI 61 covers materials that contact drinking water. Ask to see the documentation for the actual components going in your home, not just a general claim. The Blue Logic Purification System's storage tank is built from NSF/ANSI and FDA compliant materials.",
  },
  {
    question: "Does Blue Logic require a service contract?",
    answer: "No. Blue Logic does not require an ongoing service contract. Annual maintenance, which covers filter changes and a general system check, is standard and scheduled for you. Visits outside scheduled maintenance carry a $129 service call fee. Ask any provider what their ongoing service terms look like.",
  },
  {
    question: "Can I bring an Element Water quote to compare?",
    answer: "Yes. Bring any written quote to your free Blue Logic water test and we'll compare it with ours line by line: what each system treats, the full installed price, the warranty, and what ongoing service costs.",
  },
  {
    question: "What does Blue Logic's free water test actually measure?",
    answer: "A Blue Logic water test measures hardness (grains per gallon), total dissolved solids (TDS in ppm), and chlorine at your kitchen sink, and your specialist walks you through contaminant data for your city's water source. Results are shared on the spot. The test is the basis for which system Blue Logic recommends; we don't sell a one-size-fits-all solution. It's no-obligation and takes 45 to 60 minutes at your home.",
  },
];

const schemas = [
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Blue Logic vs. Element Water Utah", url: "/blue-logic-vs-element-water-utah/" },
  ]),
];
---

<Layout
  title="Blue Logic vs. Element Water Utah | 5 Questions to Ask Before You Sign"
  description="Comparing local Utah water treatment companies? Here are the questions that separate transparent providers from ones who make it hard to compare. Free water test, written quote."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Utah Water Treatment · Comparison Guide
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Comparing Local Utah Water Treatment Companies:<br />What to Ask Before You Sign
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        If Element Water is on your list alongside Blue Logic, the right move is to get
        written quotes from both and compare them on the same terms. These are the five
        questions that actually separate one provider from another.
      </p>
    </div>
  </section>

  <section class="bg-primary/5 border-y border-primary/20 py-6 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-muted-foreground text-center">
        <strong class="text-foreground">What this page covers:</strong> Blue Logic's verified specs and the specific questions to ask any local water treatment company before committing.
        We make no claims about Element Water's pricing or terms. Bring any written quote to your free water test and we'll compare it with ours.
      </p>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="mb-12">
        <h2 class="text-3xl font-serif text-center mb-8 text-foreground">
          5 Questions to Ask Any Local Water Treatment Company
        </h2>
        <div class="space-y-4">
          {[
            {
              number: "1",
              question: "What does the system actually treat, and how efficient is the RO?",
              why: "Ask which contaminants each part of the system addresses, and how much water the RO sends to drain for every gallon it purifies. Older RO designs can send several gallons to drain per gallon purified.",
              blueLogic: "Filtration softens and filters in one tank. Blue Logic RO runs about 3 gallons purified per 1 to drain (up to 75% recovery), which the Filtration in front makes possible by protecting the membrane.",
            },
            {
              number: "2",
              question: "What is the storage tank made of?",
              why: "With whole-home RO, your purified water sits in a storage tank, so ask what the tank is made of and what standards its materials meet. This is the detail most homeowners don't think to ask.",
              blueLogic: "165-gallon food-grade tank built from NSF/ANSI and FDA compliant materials. Homes that need more storage get additional 165-gallon tanks added as modules.",
            },
            {
              number: "3",
              question: "What is the full installed price in writing, including all components and labor?",
              why: "Some quotes separate equipment cost from installation cost, or exclude components like the delivery pump, storage tank, or under-sink RO. Always compare total installed cost.",
              blueLogic: `From about $1,000 out the door, customized to your home, with standard installation and tax included, confirmed in writing at your free water test. No hidden fees.`,
            },
            {
              number: "4",
              question: "Is a service contract required, and what does it cost per year?",
              why: "Mandatory service contracts add to the true cost of ownership. Ask what's required, what's included, and what happens if you miss a scheduled service.",
              blueLogic: "No service contract required. Annual maintenance is standard and scheduled for you; visits outside scheduled maintenance are $129.",
            },
            {
              number: "5",
              question: "Who physically performs the installation, and who is accountable for it?",
              why: "Accountability for installation quality depends on who's doing the work and who stands behind it. Ask who installs, and who you call if something isn't right.",
              blueLogic: "Co-owner Jared designs your system and oversees installation by our professional installation partner. Installation workmanship is covered for 12 months.",
            },
          ].map((item) => (
            <div class="question-card">
              <div class="flex gap-4">
                <span class="question-number">{item.number}</span>
                <div class="flex-1">
                  <h3 class="font-semibold text-foreground mb-2">{item.question}</h3>
                  <p class="text-muted-foreground text-sm mb-3 leading-relaxed">{item.why}</p>
                  <div class="blue-logic-answer">
                    <span class="text-xs font-semibold text-primary uppercase tracking-wide">Blue Logic: </span>
                    <span class="text-sm text-muted-foreground">{item.blueLogic}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">Blue Logic's Verified System Specs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
        {[
          { label: "System pricing", value: priceRange, note: "Out the door: standard installation and tax included, confirmed in writing at your free water test." },
          { label: "Storage tank materials", value: "NSF/ANSI and FDA compliant", note: "The Purification System stores purified water in a 165-gallon food-grade tank built from NSF/ANSI and FDA compliant materials." },
          { label: "Warranty", value: "5 years on defects", note: "Covers defects in materials and workmanship; consumables such as filters, RO membranes and salt are excluded. Installation workmanship is covered for 12 months." },
          { label: "Service contract required", value: "No", note: "Annual maintenance (filter changes and a system check) is standard and scheduled for you. No ongoing service contract." },
          { label: "Financing", value: "Pinnacle Finance", note: "For qualifying homeowners, subject to credit approval. Checking eligibility is a soft credit inquiry." },
          { label: "Who is accountable", value: "Owner-led", note: "Co-owner Jared designs your system and oversees installation by our professional installation partner." },
        ].map((item) => (
          <div class="spec-card">
            <div class="flex justify-between items-start gap-4 mb-2">
              <span class="font-semibold text-foreground">{item.label}</span>
              <span class="text-primary font-bold shrink-0">{item.value}</span>
            </div>
            <p class="text-xs text-muted-foreground">{item.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews compact={true} heading="What Utah Homeowners Say About Blue Logic" />
    </div>
  </section>

  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">
        Get a Transparent Second Quote
      </h2>
      <p class="text-muted-foreground text-center mb-10">
        Blue Logic's free water test gives you real measurements of your water and a written
        quote with full component details. If you have an Element Water quote, bring it and
        we'll compare the two with you. Take both quotes home and make the call yourself.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .hero-gradient {
    @apply bg-linear-to-br from-background to-card;
  }

  .question-card {
    @apply bg-card rounded-2xl border border-border p-6;
  }

  .question-number {
    @apply w-8 h-8 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center shrink-0 mt-0.5;
  }

  .blue-logic-answer {
    @apply bg-primary/5 border border-primary/20 rounded-lg px-4 py-2;
  }

  .spec-card {
    @apply bg-card p-5 rounded-xl border border-border;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
