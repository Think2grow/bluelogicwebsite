---
import Layout from "../../layouts/Layout.astro";
import { cities } from "../../data/cities";
import { getBreadcrumbSchema } from "../../utils/schema";
import { Image } from "astro:assets";
import utilityRoomSystemImg from "../../assets/real/installs/purification-room-storage-tanks.jpg";

export const prerender = true;

// Sort cities alphabetically. Cities flagged outsideServiceArea keep their
// pages but are left out of this grid.
const sortedCities = cities
  .filter((city) => !city.outsideServiceArea)
  .sort((a, b) => a.name.localeCompare(b.name));

// Generate page-specific JSON-LD schemas
const siteUrl = Astro.site?.toString() || "https://bluelogicwater.com";
const currentUrl = new URL("/locations", siteUrl).toString();

const schemas = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
  ]),
];
---

<Layout
  title="Water Filtration Locations - Blue Logic Water Utah"
  description="Blue Logic Water softening, filtration and reverse osmosis systems for Salt Lake, Davis, Utah County, Tooele and Ogden-area homes. See water data for your city."
  schema={schemas}
>
  <section class="hero-gradient-dark py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-serif mb-4 text-white">
        Utah Water Solutions by Location
      </h1>
      <p class="text-xl md:text-2xl text-white/90">
        See what is in your city's water, then test your own at the kitchen
        sink
      </p>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-lg leading-relaxed text-muted-foreground">
          Utah's water varies from city to city. Salt Lake City's supply shows
          PFAS, Lehi's shows arsenic above EWG's stricter guidelines, and much
          of the valley is very hard. <a
            href="/the-system/"
            class="text-primary hover:underline font-semibold"
            >Blue Logic tests your water first</a
          > and recommends the system your home actually needs.
        </p>
      </div>

      <!-- Utah's Water Challenge -->
      <div class="max-w-3xl mx-auto text-center mb-16">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Utah's Water Challenge
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Utah has some of the hardest water in the nation. The minerals that
            make our mountains beautiful also leave scale buildup on your
            fixtures, shorten appliance lifespans, and leave a chalky film on
            dishes and glass.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-8">
            Pick your city below to see its hardness, its water source and what
            the EWG database reports. <a
              href="/the-system/"
              class="text-primary hover:underline font-semibold"
              >See how a Blue Logic system is built</a
            >.
          </p>
          <a
            href="/free-water-test/#schedule"
            class="text-primary font-semibold text-lg hover:opacity-80 transition-opacity"
          >
            Schedule Your Free Water Test →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
        {
          sortedCities.map((city) => (
            <a href={`/locations/${city.slug}/`} class="location-card">
              <div class="card-header">
                <h2 class="text-2xl font-serif text-foreground mb-2">
                  {city.name}
                </h2>
                <p class="text-sm font-medium text-muted-foreground">
                  {city.region}
                </p>
              </div>

              <div class="card-content">
                <div class="stat-row">
                  <span class="stat-label">Water Hardness:</span>
                  <span class="stat-value">{city.hardnessLevel}</span>
                </div>

                <div class="stat-row">
                  <span class="stat-label">TDS Range:</span>
                  <span class="stat-value">{city.tdsRange}</span>
                </div>

                {city.contaminantsExceedingGuidelines && (
                  <div class="stat-row-alert">
                    <span class="stat-label">Above EWG Guidelines:</span>
                    <span class="text-destructive font-bold">
                      {city.contaminantsExceedingGuidelines} contaminants
                    </span>
                  </div>
                )}

                <p class="text-sm text-muted-foreground leading-relaxed mt-4">
                  {city.description}
                </p>
              </div>

              <div class="card-footer">
                <span class="text-primary font-semibold">View Details →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-12 text-foreground"
      >
        Why Location Matters
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="reason-card">
          <div class="text-5xl mb-4">🗺️</div>
          <h3 class="text-xl font-serif mb-4 text-foreground">
            Different Water Sources
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Each Utah city draws from different water sources (mountain
            watersheds, valley aquifers, or purchased surface water), each with
            <a
              href="/the-value/"
              class="text-primary hover:underline font-semibold"
              >distinct mineral and contaminant profiles</a
            >.
          </p>
        </div>

        <div class="reason-card">
          <div class="text-5xl mb-4">⚡</div>
          <h3 class="text-xl font-serif mb-4 text-foreground">
            Different Contaminants
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Arsenic, PFAS, chromium-6 and disinfection byproducts show up at
            different levels from city to city, which is why we test before we
            recommend anything.
          </p>
        </div>

        <div class="reason-card">
          <div class="text-5xl mb-4">💰</div>
          <h3 class="text-xl font-serif mb-4 text-foreground">
            Tailored Solutions
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            <a
              href="/the-system/"
              class="text-primary hover:underline font-semibold"
              >Blue Logic matches the system to your water test</a
            >, so your home gets what it needs and nothing it doesn't.
          </p>
        </div>

        <div class="reason-card">
          <div class="text-5xl mb-4">🏘️</div>
          <h3 class="text-xl font-serif mb-4 text-foreground">
            Local Expertise
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Blue Logic is family-owned and locally owned. We know how source
            water shifts with the seasons and what each city's supply looks
            like. <a href="/our-team/" class="text-primary hover:underline font-semibold"
              >Meet our team</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Blue Logic Difference -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            The Blue Logic Difference
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Soft water that feels better on skin and hair, no chlorine smell in
            the shower, and with the Blue Logic Purification System, purified
            water at every tap.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-8">
            Every system is sized to your home and your water test, and prices
            are out the door, with installation and tax included.
          </p>
          <a
            href="/free-water-test/#schedule"
            class="text-primary font-semibold text-lg hover:opacity-80 transition-opacity"
          >
            Book Your Free Water Test →
          </a>
        </div>
        <div class="order-1 lg:order-2">
          <Image
            src={utilityRoomSystemImg}
            alt="Blue Logic Purification System in a Utah home's mechanical room: purified water storage tanks, Filtration pretreatment tank, reverse osmosis unit and brine tank"
            class="rounded-2xl shadow-2xl w-full object-cover aspect-4/5"
            widths={[400, 600, 800, 1100]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={60}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-obsidian py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif mb-4 text-white">
        Don't See Your Location?
      </h2>
      <p class="text-lg text-white/90 mb-8">
        Blue Logic Water serves homes across Salt Lake County, Davis County,
        Utah County, the Tooele valley and the Ogden/Weber area. If your city
        isn't listed, <a href="/free-water-test/#schedule" class="underline hover:no-underline"
          >reach out</a
        > and we'll let you know how we can help, or <a
          href="/common-questions/"
          class="underline hover:no-underline"
          >check our FAQ for the full service list</a
        >.
      </p>
      <a href="/free-water-test/#schedule" class="btn btn-primary btn-lg w-full md:w-auto"
        >Contact Us About Your Area</a
      >
    </div>
  </section>
</Layout>

<style>
  @reference "../../styles/global.css";
  .hero-gradient-dark {
    @apply bg-linear-to-br from-primary to-primary/70;
  }

  .bg-obsidian {
    background-color: var(--color-obsidian);
  }

  .location-card {
    @apply flex flex-col bg-background rounded-2xl overflow-hidden no-underline border-2 border-border transition-all duration-300;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .location-card:hover {
    @apply border-primary -translate-y-1;
    box-shadow: 0 12px 32px rgba(97, 137, 184, 0.12);
  }

  .card-header {
    @apply p-6 pb-4 border-b border-border bg-card;
  }

  .card-content {
    @apply p-6 flex-1;
  }

  .stat-row {
    @apply flex justify-between items-center py-3 border-b border-border text-sm;
  }

  .stat-row:last-of-type {
    @apply border-b-0 pb-0 mb-0;
  }

  .stat-label {
    @apply font-semibold text-muted-foreground;
  }

  .stat-value {
    @apply text-foreground font-medium;
  }

  .stat-row-alert {
    @apply flex justify-between items-center p-3 rounded-lg bg-destructive/10 my-2;
  }

  .card-footer {
    @apply p-4 border-t border-border bg-card/50;
  }

  .reason-card {
    @apply bg-card p-8 rounded-2xl text-center border border-border transition-all duration-300;
  }

  .reason-card:hover {
    @apply border-primary;
    box-shadow: 0 8px 24px rgba(97, 137, 184, 0.1);
  }
</style>
