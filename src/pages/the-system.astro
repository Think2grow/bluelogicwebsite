---
import Layout from "../layouts/Layout.astro";
import { getProductSchema, getBreadcrumbSchema, getServiceSchema } from "../utils/schema";
import FilterFlowParallax from "../components/FilterFlowParallax.astro";
import { Image } from "astro:assets";
import utilityRoomSystemImg from "../assets/real/utility-room-system-full.jpg";
import purificationComponentsImg from "../assets/water_art/filters_tank_pump_system_product_picture.jpg";
import filtrationProductImg from "../assets/WH Filtration Product.png";
import { OFFER_HEADLINE, OFFER_SUBHEAD, OFFER_DISCLOSURE, offerActive } from "../data/offer";

export const prerender = true;

const showOffer = offerActive();

const siteUrl = "https://www.bluelogicwater.com";

// This page overrides the shared product schema description and price range
// with Purification-specific copy and the current out-the-door range.
const productSchema = getProductSchema(`${siteUrl}/the-system/`);

const schemas = [
  {
    ...productSchema,
    description:
      "Whole-home reverse osmosis from Blue Logic Water: Blue Logic Filtration in front, then reverse osmosis, a 165-gallon food-grade storage tank and a Grundfos SCALA2 constant-pressure pump, so every tap runs purified water. Systems from $2,999 to $19,999, installation and tax included. Serving Utah's Wasatch Front.",
    offers: { ...productSchema.offers, lowPrice: "2999", highPrice: "19999" },
  },
  getServiceSchema(
    `${siteUrl}/the-system/`,
    "Blue Logic Water Treatment Systems, Utah",
    "Blue Logic installs whole-home reverse osmosis, whole-home filtration and water softener systems across Utah's Wasatch Front. Filtration softens and filters every tap in one self-cleaning tank and includes an under-sink reverse osmosis system at the kitchen tap.",
  ),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Our Systems", url: "/the-system/" },
  ]),
];
---

<Layout
  title="Water Treatment Systems Utah | Blue Logic Water"
  description="Blue Logic installs whole-home reverse osmosis, whole-home filtration and water softeners across Utah's Wasatch Front. Filtration includes an under-sink RO. Free water test."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-serif mb-4 text-foreground">
        Blue Logic Water Treatment Systems
      </h1>
      <p class="text-xl md:text-2xl text-muted-foreground">
        Whole-home reverse osmosis, filtration, and water softening for Utah homes
      </p>
    </div>
    {showOffer && (
      <div class="max-w-3xl mx-auto mt-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-2">Current Offer</p>
        <p class="text-xl md:text-2xl font-serif text-foreground mb-1">{OFFER_HEADLINE}</p>
        <p class="text-muted-foreground mb-3">{OFFER_SUBHEAD}</p>
        <p class="text-xs text-muted-foreground leading-relaxed">{OFFER_DISCLOSURE}</p>
      </div>
    )}
  </section>

  <!-- Visual Impact: Before/After -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Image
            src={utilityRoomSystemImg}
            alt="Blue Logic Purification System installed in a Utah home's utility room: reverse osmosis unit, filtration tank with digital control valve, pre-filter housing and brine tank"
            class="rounded-2xl shadow-2xl w-full object-cover aspect-4/3"
            widths={[400, 600, 800, 1100]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={60}
            loading="lazy"
          />
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            See the Difference
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            <a
              href="/the-value/"
              class="text-primary hover:underline font-semibold"
              >Utah's water carries more than you can see</a
            >: hardness minerals, chlorine and chloramine, sediment, and dissolved
            contaminants that affect taste, health, and your home's plumbing and
            appliances.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Our systems turn municipal water into clear, great-tasting water, and with
            whole-home reverse osmosis, purified water at every tap in your home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        Three Approaches to Water Treatment
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-12"
      >
        Not all water treatment is created equal. Here's how softening,
        filtration, and purification compare.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="approach-card approach-basic">
          <div class="mb-4">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">
              Blue Logic Softener
            </h3>
            <p
              class="text-sm font-bold uppercase tracking-wider text-muted-foreground"
            >
              Hardness Only
            </p>
          </div>
          <p class="text-lg font-semibold mb-4 text-foreground/80">
            Protects Your Home From Hard Water
          </p>
          <p class="text-muted-foreground leading-relaxed mb-6">
            A softener removes the calcium and magnesium that cause scale. It
            protects pipes and appliances, but softening is not filtration.
          </p>
          <div class="mb-6">
            <h4
              class="text-sm font-bold uppercase tracking-wider mb-3 text-foreground/80"
            >
              What it does:
            </h4>
            <ul class="space-y-2">
              <li class="approach-list-item">
                Prevents mineral scale in pipes and appliances
              </li>
              <li class="approach-list-item">
                Makes soap and detergents more effective
              </li>
              <li class="approach-list-item">
                Reduces water spots on dishes and fixtures
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-border text-sm text-muted-foreground">
            <strong class="text-foreground">Verdict:</strong> The right fit when your
            concern is scale and appliances. It does not remove chlorine, taste and
            odor, or other contaminants.
          </div>
          <a href="/water-softener-utah/" class="inline-block mt-4 text-sm text-primary font-semibold hover:opacity-80 transition-opacity">
            Water Softener Utah →
          </a>
        </div>

        <div class="approach-card approach-better">
          <div class="mb-4">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">
              Blue Logic Filtration
            </h3>
            <p class="text-sm font-bold uppercase tracking-wider text-primary">
              Most Common
            </p>
          </div>
          <p class="text-lg font-semibold mb-4 text-foreground/80">
            Real Protection for Your Home
          </p>
          <p class="text-muted-foreground leading-relaxed mb-6">
            Whole-home softening and filtration in one self-cleaning tank, plus an
            under-sink reverse osmosis system for purified drinking water at the
            kitchen tap.
          </p>
          <div class="mb-6">
            <h4
              class="text-sm font-bold uppercase tracking-wider mb-3 text-foreground/80"
            >
              What it does:
            </h4>
            <ul class="space-y-2">
              <li class="approach-list-item">
                Soft water: scale and appliance protection
              </li>
              <li class="approach-list-item">
                Chlorine and chloramine taste and odor removed home-wide
              </li>
              <li class="approach-list-item">
                Fine sand, rust and sediment filtered out
              </li>
              <li class="approach-list-item">
                Purified drinking water at the kitchen tap
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-border text-sm text-muted-foreground">
            <strong class="text-foreground">Verdict:</strong> Soft, filtered water at
            every tap and purified water where you drink and cook.
          </div>
          <a href="/whole-home-water-filtration/" class="inline-block mt-4 text-sm text-primary font-semibold hover:opacity-80 transition-opacity">
            Whole-Home Filtration Details →
          </a>
        </div>

        <div class="approach-card approach-best">
          <div class="mb-4">
            <h3 class="text-2xl font-semibold mb-2 text-foreground">
              Blue Logic Purification System
            </h3>
            <p class="text-sm font-bold uppercase tracking-wider text-success">
              Purified at Every Tap
            </p>
          </div>
          <p class="text-lg font-semibold mb-4 text-foreground/80">
            The Ultimate in Clean Water
          </p>
          <p class="text-muted-foreground leading-relaxed mb-6">
            Blue Logic Filtration in front, then whole-home reverse osmosis,
            storage and constant pressure, so every tap in your home runs purified
            water.
          </p>
          <div class="mb-6">
            <h4
              class="text-sm font-bold uppercase tracking-wider mb-3 text-foreground/80"
            >
              What it does:
            </h4>
            <ul class="space-y-2">
              <li class="approach-list-item">
                Everything Filtration does, then purifies the whole home
              </li>
              <li class="approach-list-item">
                Reduces lead, arsenic, fluoride, nitrates, PFAS, pharmaceuticals and microplastics
              </li>
              <li class="approach-list-item">
                Purified water for every sink, shower, and appliance
              </li>
              <li class="approach-list-item">
                165-gallon purified storage and constant pressure
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-border text-sm text-muted-foreground">
            <strong class="text-foreground">Verdict:</strong> Our best system: pure,
            balanced water at every tap in the home.
          </div>
          <a href="/whole-home-reverse-osmosis-utah/" class="inline-block mt-4 text-sm text-primary font-semibold hover:opacity-80 transition-opacity">
            Whole-Home RO Details →
          </a>
        </div>
      </div>

      <div
        class="max-w-4xl mx-auto mt-16 bg-primary/5 border-2 border-primary rounded-2xl p-8 md:p-12"
      >
        <h3
          class="text-2xl md:text-3xl font-serif mb-6 text-center text-foreground"
        >
          Two Whole-Home Systems, One Expert Team
        </h3>
        <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
          Blue Logic offers two comprehensive whole-home water solutions
          tailored to your needs and budget:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div class="bg-card p-6 rounded-xl">
            <h4 class="text-xl font-semibold mb-3 text-primary">
              Blue Logic Filtration
            </h4>
            <p class="text-muted-foreground mb-4">
              Softening and filtration for the whole home in one self-cleaning
              tank. Soft, filtered water throughout your home, with purified
              drinking water at the kitchen sink.
            </p>
            <p class="text-sm font-semibold text-foreground">
              Includes: Whole-home softening and filtration tank + under-sink
              reverse osmosis at the kitchen tap
            </p>
          </div>
          <div class="bg-card p-6 rounded-xl border-2 border-primary">
            <h4 class="text-xl font-semibold mb-3 text-primary">
              Blue Logic Purification System
            </h4>
            <p class="text-muted-foreground mb-4">
              Everything Filtration does to the whole home, PLUS reverse osmosis
              purification and storage for the ultimate in water purity at every
              tap.
            </p>
            <p class="text-sm font-semibold text-foreground">
              Includes: Blue Logic Filtration + sediment pre-filter + reverse
              osmosis + 165-gallon storage tank + Grundfos SCALA2 constant-pressure
              pump
            </p>
          </div>
        </div>
        <p class="text-center text-muted-foreground italic">
          Our purification system builds on our filtration foundation: the
          Filtration in front protects the RO membrane, so the RO can run at about
          3 gallons of purified water for every 1 sent to drain.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Filter Flow Visualization -->
  <FilterFlowParallax />

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        Whole Home Reverse Osmosis Purification
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-12"
      >
        The Blue Logic Purification System is built from modular components, each
        doing one job well, to deliver pure water at every tap in your home.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 bg-card rounded-2xl">
            <h3 class="text-xl font-semibold mb-4 text-primary">
              Purification at Every Tap
            </h3>
            <p class="font-semibold mb-2 text-foreground">
              Down to about 0.0001 microns
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Reduces dissolved solids, heavy metals, PFAS, pharmaceuticals, and
              microplastics throughout the home.
            </p>
          </div>

          <div class="p-8 bg-card rounded-2xl">
            <h3 class="text-xl font-semibold mb-4 text-primary">
              Efficient by Design
            </h3>
            <p class="font-semibold mb-2 text-foreground">
              About 3 gallons purified for every 1 to drain
            </p>
            <p class="text-muted-foreground leading-relaxed">
              Up to 75% recovery, made possible by the Filtration in front that
              protects the RO membrane.
            </p>
          </div>

          <div class="p-8 bg-card rounded-2xl">
            <h3 class="text-xl font-semibold mb-4 text-primary">
              Normal Pressure Everywhere
            </h3>
            <p class="font-semibold mb-2 text-foreground">
              Grundfos SCALA2 constant-pressure pump
            </p>
            <p class="text-muted-foreground leading-relaxed">
              A variable-speed pump regulates pressure automatically, so purified
              water feels like normal city pressure.
            </p>
          </div>

          <div class="p-8 bg-card rounded-2xl">
            <h3 class="text-xl font-semibold mb-4 text-primary">
              Storage That Fits Your Home
            </h3>
            <p class="font-semibold mb-2 text-foreground">
              165-gallon food-grade tank
            </p>
            <p class="text-muted-foreground leading-relaxed">
              BPA-free, built with NSF/ANSI and FDA compliant materials. Homes that
              need more add a second 165-gallon tank.
            </p>
          </div>
        </div>
        <div>
          <Image
            src={purificationComponentsImg}
            alt="Blue Logic Purification System components: filtration tank and brine tank, pre-filter housing, Grundfos constant-pressure pump, reverse osmosis unit and 165-gallon storage tank"
            class="rounded-2xl shadow-2xl w-full object-contain bg-white"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={60}
          />
          <p class="text-sm text-muted-foreground text-center mt-4 italic">
            Every component of the Blue Logic Purification System
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        Blue Logic Filtration
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-12"
      >
        For those who want soft, filtered water throughout the home without full
        purification, Blue Logic Filtration does it all in one tank, with
        purified drinking water at the kitchen tap.
      </p>

      <div class="max-w-xs mx-auto mb-12">
        <Image
          src={filtrationProductImg}
          alt="Blue Logic Whole-Home Filtration tank with its digital control valve, standing beside a matching black brine tank"
          class="w-full object-contain"
          widths={[300, 500]}
          sizes="320px"
          quality={70}
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="filtration-card">
          <h3 class="text-xl font-semibold mb-4 text-foreground">
            🧪 One Tank, Soft and Filtered
          </h3>
          <p class="text-muted-foreground leading-relaxed mb-4">
            Softening and filtration happen together in one self-cleaning tank, so
            the whole home gets:
          </p>
          <ul class="space-y-3">
            <li class="text-muted-foreground text-sm leading-relaxed">
              <strong class="text-foreground">Soft water</strong>: no new scale on
              fixtures or inside appliances
            </li>
            <li class="text-muted-foreground text-sm leading-relaxed">
              <strong class="text-foreground">No chlorine or chloramine</strong>: the
              taste and odor are gone at every tap
            </li>
            <li class="text-muted-foreground text-sm leading-relaxed">
              <strong class="text-foreground">Clear water</strong>: sediment and rust
              filtered out
            </li>
            <li class="text-muted-foreground text-sm leading-relaxed">
              <strong class="text-foreground">Softer skin and hair</strong>: showers
              without chlorine or hard water
            </li>
          </ul>
        </div>

        <div class="filtration-card">
          <h3 class="text-xl font-semibold mb-4 text-foreground">
            💧 Purified Water at the Kitchen Tap
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Every Filtration system includes an under-sink reverse osmosis system
            with its own dedicated tap, for purified drinking and cooking water.
          </p>
        </div>

        <div class="filtration-card">
          <h3 class="text-xl font-semibold mb-4 text-foreground">
            🏡 Whole-Home Coverage
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Clean, soft water flows to every tap, shower, and appliance.
            Protects your investment and your family at the same time.
          </p>
        </div>

        <div class="filtration-card">
          <h3 class="text-xl font-semibold mb-4 text-foreground">
            ⚙️ Low Maintenance
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            The tank regenerates automatically based on your water use. You keep
            salt in the brine tank, we handle annual maintenance, and the system is
            covered by a 5-year warranty against defects.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        How Whole-Home Purification Works
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-8"
      >
        Our purification system builds on Blue Logic Filtration. Stage 1 (Blue
        Logic Filtration) works on its own, or pairs with the sediment
        pre-filter, reverse osmosis, storage and constant-pressure pump for
        whole-home purification.
      </p>
      <div
        class="text-center mb-12 bg-accent/50 py-4 px-6 rounded-xl max-w-2xl mx-auto"
      >
        <p class="text-foreground font-semibold">
          💡 The filtration in front isn't optional: it protects the RO membrane
          and is what lets the RO run efficiently.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">
            Softening + Filtration
          </h3>
          <p class="text-sm text-muted-foreground mb-2">
            <span
              class="inline-block bg-primary/10 text-primary text-xs font-bold px-2 py-1 rounded mb-2"
              >BLUE LOGIC FILTRATION</span
            >
          </p>
          <p class="text-sm text-muted-foreground mb-4">
            Prepares water for purification, or serves as standalone whole-home
            filtration
          </p>
          <ul class="space-y-2 text-left">
            <li class="text-sm text-muted-foreground">
              Softens and filters in one self-cleaning tank
            </li>
            <li class="text-sm text-muted-foreground">
              Removes chlorine, chloramine, sediment and rust
            </li>
            <li class="text-sm text-muted-foreground">
              Protects the RO membrane in the Purification System
            </li>
          </ul>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">
            Reverse Osmosis Unit
          </h3>
          <p class="text-sm text-muted-foreground mb-2">
            <span
              class="inline-block bg-success/10 text-success text-xs font-bold px-2 py-1 rounded mb-2"
              >PURIFICATION SYSTEM</span
            >
          </p>
          <p class="text-sm text-muted-foreground mb-4">
            Removes what filtration cannot: the contaminants dissolved in the water
          </p>
          <ul class="space-y-2 text-left">
            <li class="text-sm text-muted-foreground">
              A sediment pre-filter guards the membrane
            </li>
            <li class="text-sm text-muted-foreground">
              Removes contaminants larger than about 0.0001 microns
            </li>
            <li class="text-sm text-muted-foreground">
              Reduces dissolved solids, heavy metals, PFAS and more
            </li>
            <li class="text-sm text-muted-foreground">
              About 3 gallons purified for every 1 sent to drain
            </li>
          </ul>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">
            165-Gallon Storage Tank
          </h3>
          <p class="text-sm text-muted-foreground mb-2">
            <span
              class="inline-block bg-success/10 text-success text-xs font-bold px-2 py-1 rounded mb-2"
              >PURIFICATION SYSTEM</span
            >
          </p>
          <p class="text-sm text-muted-foreground mb-4">
            Keeps purified water on hand for the whole home
          </p>
          <ul class="space-y-2 text-left">
            <li class="text-sm text-muted-foreground">
              Purified water ready on demand
            </li>
            <li class="text-sm text-muted-foreground">
              Food-grade, BPA-free, NSF/ANSI and FDA compliant materials
            </li>
            <li class="text-sm text-muted-foreground">
              Add a second 165-gallon tank when your home needs more
            </li>
          </ul>
        </div>

        <div class="step-card">
          <div class="step-number">4</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">
            Constant-Pressure Pump
          </h3>
          <p class="text-sm text-muted-foreground mb-2">
            <span
              class="inline-block bg-success/10 text-success text-xs font-bold px-2 py-1 rounded mb-2"
              >PURIFICATION SYSTEM</span
            >
          </p>
          <p class="text-sm text-muted-foreground mb-4">
            A Grundfos SCALA2 delivers purified water at normal pressure
          </p>
          <ul class="space-y-2 text-left">
            <li class="text-sm text-muted-foreground">
              Automatic pressure regulation
            </li>
            <li class="text-sm text-muted-foreground">
              Variable speed with soft start
            </li>
            <li class="text-sm text-muted-foreground">
              Dry-run and low-flow protection
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif mb-4 text-foreground">
        Ready to Experience the Difference?
      </h2>
      <p class="text-xl text-muted-foreground mb-6">
        Schedule a free water quality assessment
      </p>
      <a href="/free-water-test/" class="btn btn-primary btn-lg w-full md:w-auto">Get Started</a>
      <p class="text-muted-foreground mt-8">
        Want to understand the cost benefits? See <a
          href="/the-value/"
          class="text-primary hover:underline font-semibold"
          >the long-term value of a Blue Logic system</a
        >.
      </p>
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .approach-card {
