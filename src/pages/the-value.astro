---
import Layout from "../layouts/Layout.astro";
import { getBreadcrumbSchema } from "../utils/schema";
import OfferBanner from "../components/OfferBanner.astro";
import { PRICES, usd } from "../data/offer";

export const prerender = true;

const siteUrl = "https://www.bluelogicwater.com";
const schemas = [
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Why Blue Logic", url: "/the-value/" },
  ]),
];
---

<Layout
  title="Why Choose Blue Logic | Water Treatment Utah | Out-the-Door Pricing"
  description={`Blue Logic water solutions start at about $1,000 out the door, customized to your home, with installation and tax included and a 5-year warranty. Free water test at your kitchen sink.`}
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-serif mb-4 text-foreground">
        Why Choose Blue Logic for Utah Whole-Home Water Treatment
      </h1>
      <p class="text-xl md:text-2xl text-muted-foreground">
        Water treatment sized to your home, with honest out-the-door pricing
      </p>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        Blue Logic vs. the Competition
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-12"
      >
        Every Blue Logic price is out the door, with standard installation and tax included.
        Here's what you get, and the questions worth asking about any other quote. Learn more
        about <a
          href="/the-system/"
          class="text-primary hover:underline font-semibold"
          >how our system works</a
        >.
      </p>

      <div class="max-w-4xl mx-auto bg-card rounded-2xl overflow-hidden">
        <div
          class="grid grid-cols-3 gap-4 p-6 bg-secondary text-secondary-foreground font-bold text-sm uppercase tracking-wider"
        >
          <div>Feature</div>
          <div class="text-center">Blue Logic</div>
          <div class="text-center">Ask Any Other Quote</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Price</div>
          <div class="text-center text-primary font-bold">From about $1,000 out the door, customized</div>
          <div class="text-center text-sm">Are installation and tax included?</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Whole-Home RO</div>
          <div class="text-center">Filtration in front, RO, 165-gallon storage, constant pressure</div>
          <div class="text-center text-sm">Is pre-treatment included in front of the RO?</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Water Efficiency</div>
          <div class="text-center text-primary font-bold">About 3 gallons purified per 1 to drain</div>
          <div class="text-center text-sm">How much water goes to drain?</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Upgrade Path</div>
          <div class="text-center">Modular: add reverse osmosis later</div>
          <div class="text-center text-sm">Can you upgrade without replacing equipment?</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Warranty</div>
          <div class="text-center">5 years on defects, 10 years on tank media, 12 months on installation</div>
          <div class="text-center text-sm">What is covered, and for how long?</div>
        </div>

        <div class="comparison-row">
          <div class="font-semibold">Local Service</div>
          <div class="text-center">✓ Family-owned, Murray, Utah</div>
          <div class="text-center text-sm">Who answers when something goes wrong?</div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-12 text-foreground"
      >
        How We Keep Pricing Fair
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 bg-background rounded-2xl">
          <h3 class="text-xl font-semibold mb-4 text-primary">
            Our Own Equipment
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Blue Logic builds its own softening and filtration units and supplies them from our
            Murray, Utah warehouse, so you deal directly with the people who stand behind your
            system.
          </p>
        </div>

        <div class="p-8 bg-background rounded-2xl">
          <h3 class="text-xl font-semibold mb-4 text-primary">
            Modular Engineering
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Our <a
              href="/the-system/"
              class="text-primary hover:underline font-semibold"
              >systems are modular</a
            > and sized to your home, so you pay for what your water needs, and you can add
            reverse osmosis later without starting over.
          </p>
        </div>

        <div class="p-8 bg-background rounded-2xl">
          <h3 class="text-xl font-semibold mb-4 text-primary">Local Focus</h3>
          <p class="text-muted-foreground leading-relaxed">
            We serve homes across the <a
              href="/locations/"
              class="text-primary hover:underline font-semibold"
              >Wasatch Front</a
            > from our Murray warehouse, which keeps overhead down and keeps us close by when you need service.
          </p>
        </div>

        <div class="p-8 bg-background rounded-2xl">
          <h3 class="text-xl font-semibold mb-4 text-primary">
            Out-the-Door Pricing
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Standard installation and tax are included in every price. Any non-standard work is
            discussed and priced at your consult, before any work is done.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-6 text-foreground"
      >
        What Utah Water Brings Into Your Home
      </h2>
      <p
        class="text-lg text-center text-muted-foreground max-w-3xl mx-auto mb-12"
      >
        Taste is only part of it. Here is what a water system can address, and
        which Blue Logic system handles each one.
      </p>

      <div class="max-w-5xl mx-auto mb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="threat-card">
            <div class="text-4xl mb-4">⚗️</div>
            <h3 class="text-xl font-bold mb-4 text-foreground">
              PFAS & Forever Chemicals
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Industrial chemicals that persist in the environment. Your water
              test and your city's water report show what is in your supply, and
              the Purification System reduces PFAS at every tap.
            </p>
          </div>

          <div class="threat-card">
            <div class="text-4xl mb-4">🧬</div>
            <h3 class="text-xl font-bold mb-4 text-foreground">
              Microplastics
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Tiny plastic fragments that have been detected in both tap and
              bottled water. The Purification System's reverse osmosis reduces
              them at every tap.
            </p>
          </div>

          <div class="threat-card">
            <div class="text-4xl mb-4">🚿</div>
            <h3 class="text-xl font-bold mb-4 text-foreground">
              Shower and Bath Exposure
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Drinking is not the only way you use water. Hot showers put
              chlorine and its byproducts in the air and on your skin. Blue Logic
              Filtration removes chlorine and chloramine at every tap, including
              the shower.
            </p>
          </div>

          <div class="threat-card">
            <div class="text-4xl mb-4">🔧</div>
            <h3 class="text-xl font-bold mb-4 text-foreground">
              Hard Water & Scale Damage
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Calcium and magnesium minerals create scale buildup that shortens
              appliance life, clogs pipes, and wastes money on soap and repairs.
              Every Blue Logic system softens the water.
            </p>
          </div>

          <div class="threat-card md:col-span-2">
            <div class="text-4xl mb-4">☣️</div>
            <h3 class="text-xl font-bold mb-4 text-foreground">
              Chlorine & Byproducts
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed">
              Cities use chlorine or chloramine to keep water safe in the pipes.
              It leaves a taste and smell behind, and it and its byproducts can
              dry out skin and dull hair.
            </p>
          </div>
        </div>
      </div>

      <p
        class="text-lg text-center text-foreground font-medium max-w-3xl mx-auto p-8 bg-accent rounded-2xl"
      >
        The Blue Logic Purification System addresses all five at every faucet,
        shower and appliance in your home. Blue Logic Filtration handles
        hardness, chlorine and sediment at every tap, with purified drinking
        water at the kitchen sink.
      </p>
    </div>
  </section>

  <!-- Day-to-day difference -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mx-auto text-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            The Difference You Notice Every Day
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Treated water shows up in small ways: softer skin and hair after a
            shower, no new mineral buildup on fixtures, and no spots on
            glassware.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-8">
            It is not flashy. You simply notice it every time you turn on a
            tap.
          </p>
          <a
            href="/common-questions/"
            class="text-primary font-semibold text-lg hover:opacity-80 transition-opacity"
          >
            Have Questions? Check Our FAQs →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif mb-8 text-foreground">
        The Blue Logic Warranty
      </h2>
      <p
        class="text-lg text-muted-foreground mb-12 max-w-3xl mx-auto leading-relaxed"
      >
        Every system is installed by our licensed installation partner, Pure Logic Solutions,
        and backed in writing: 5 years on defects in materials and workmanship, 10 years on the media inside the treatment tank, plus 12 months
        on installation workmanship. Standard installation and tax are always included in the
        price.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="p-8 bg-card rounded-2xl">
          <strong class="block text-lg mb-2 text-foreground"
            >Professional Installation</strong
          >
          <p class="text-muted-foreground">Licensed installation partner</p>
        </div>
        <div class="p-8 bg-card rounded-2xl">
          <strong class="block text-lg mb-2 text-foreground"
            >Out-the-Door Pricing</strong
          >
          <p class="text-muted-foreground">Installation and tax included</p>
        </div>
        <div class="p-8 bg-card rounded-2xl">
          <strong class="block text-lg mb-2 text-foreground"
            >5-Year Warranty</strong
          >
          <p class="text-muted-foreground">Covers defects in materials and workmanship</p>
        </div>
      </div>
    </div>
  </section>

  <OfferBanner />

  <section class="bg-card py-16 md:py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif mb-4 text-foreground">
        Ready to See What Your Home Needs?
      </h2>
      <p class="text-xl text-muted-foreground mb-8">
        Book a free water test at your kitchen sink
      </p>
      <a href="/free-water-test/#schedule" class="btn btn-primary btn-lg w-full md:w-auto">Schedule Free Water Test</a>
    </div>
  </section>

  <!-- Related pages -->
  <section class="bg-card py-10 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-semibold text-foreground mb-4">Explore more</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/blue-logic-vs-culligan-utah/" class="related-link">vs. Culligan</a>
        <a href="/blue-logic-vs-kinetico-utah/" class="related-link">vs. Kinetico</a>
        <a href="/whole-home-reverse-osmosis-utah/" class="related-link">Whole-Home RO</a>
        <a href="/water-softener-vs-whole-home-filtration/" class="related-link">Compare All Options</a>
        <a href="/free-water-test/#schedule" class="related-link">Free Water Test</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .related-link {
    @apply px-4 py-2 bg-background border border-border rounded-full text-sm text-primary font-medium hover:border-primary transition-colors;
  }
  .comparison-row {
    @apply grid grid-cols-3 gap-4 p-6 items-center border-b border-border last:border-b-0;
  }

  .threat-card {
    @apply bg-card p-8 rounded-2xl border-l-4 border-primary;
  }
</style>
