---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import { getServiceSchema, getFAQSchema, getBreadcrumbSchema, getAggregateRatingSchema } from "../utils/schema";
import { Image } from "astro:assets";
import valveHeadImg from "../assets/real/filtration-valve-head-2.jpg";

export const prerender = true;

const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "Does Blue Logic install water softeners?",
    answer: "Yes. The Blue Logic Softener is our own softener, installed by our team across the Wasatch Front. It removes the calcium and magnesium that cause scale, spots and dry skin, and it also handles dissolved iron. If you also want chlorine and chloramine taste and odor gone and sediment filtered out, Blue Logic Filtration softens and filters in the same tank. A free water test will confirm which one is the right fit for your home.",
  },
  {
    question: "What is the water hardness in Utah, and why does it matter?",
    answer: "Water along the Wasatch Front is hard. Most communities receive water at 15 to 25+ grains per gallon (GPG), compared to the 0 to 3 GPG range considered 'soft.' At those hardness levels, mineral scale builds up quickly on fixtures and inside appliances. Scale makes water heaters work harder and can shorten the life of the appliances that use your water.",
  },
  {
    question: "What does a water softener NOT remove?",
    answer: "A standard water softener removes calcium and magnesium (the minerals that cause hardness) through ion exchange. It does not meaningfully reduce chlorine, chloramine, sediment, PFAS, arsenic, nitrates, or most other contaminants. Blue Logic Filtration adds chlorine and chloramine taste and odor, sediment and rust removal for the whole home, plus an under-sink reverse osmosis system at the kitchen tap. The Blue Logic Purification System reduces PFAS, arsenic, nitrates and dissolved solids at every tap.",
  },
  {
    question: "How much salt does a Blue Logic system use?",
    answer: "It depends on how hard your water is and how much water your home uses. Blue Logic systems regenerate based on the water you actually use rather than on a fixed timer, so salt is used only when it is needed. You keep salt in the brine tank, and it is easy to find at large local stores such as Costco and Walmart. Your specialist can estimate how often you will refill once your water is tested.",
  },
  {
    question: "Will a water softener fix the white spots on my dishes and shower doors?",
    answer: "Yes. Water softening removes the calcium and magnesium that cause those white, chalky spots. If spotting persists after softening, other dissolved solids may be contributing to the residue. Reverse osmosis reduces those: at the kitchen tap with Blue Logic Filtration, or at every tap with the Blue Logic Purification System.",
  },
  {
    question: "How is the Blue Logic Softener different from Blue Logic Filtration?",
    answer: "Both use the same style of tank. The Blue Logic Softener treats hardness, for homes whose main concern is scale and appliance protection. Blue Logic Filtration softens and filters in the same tank, removing chlorine and chloramine taste and odor, sediment and rust at every tap, and it includes an under-sink reverse osmosis system for purified drinking water at the kitchen tap. The Blue Logic Softener is $2,999 and Blue Logic Filtration is $5,999, with standard installation and tax included.",
  },
];

const schemas = [
  getServiceSchema(
    `${siteUrl}/water-softener-utah/`,
    "Water Softener Installation Utah, Blue Logic Water",
    "Blue Logic installs the Blue Logic Softener across Utah's Wasatch Front to end hard-water scale, spots and dry skin. Blue Logic Filtration and the Blue Logic Purification System also include softening, along with whole-home filtration.",
  ),
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Water Softener Utah", url: "/water-softener-utah/" },
  ]),
  getAggregateRatingSchema(`${siteUrl}/water-softener-utah/`),
];
---

<Layout
  title="Water Softener Utah | Blue Logic Water, Wasatch Front"
  description="Utah's hard water damages appliances and dries skin. Blue Logic installs water softeners and whole-home filtration that softens and filters in one tank. Free water test. Wasatch Front."
  schema={schemas}
>
  <!-- Hero -->
  <section class="hero-gradient py-20 md:py-28 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Salt Lake · Davis · Utah · Weber · Tooele Counties
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Water Softener Installation for Utah Homes
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto mb-8 leading-relaxed">
        Water along the Wasatch Front is hard. Blue Logic installs the Blue Logic Softener to
        end scale, spots and dry skin, and Blue Logic Filtration when you want softening and
        filtration in one tank.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/free-water-test/"
          class="inline-block bg-primary text-primary-foreground font-semibold text-lg px-8 py-4 rounded-full shadow-lg hover:bg-primary/90 transition-all"
        >
          Schedule Free Water Test →
        </a>
        <a
          href="tel:+18019802583"
          class="inline-block border-2 border-primary text-primary font-semibold text-lg px-8 py-4 rounded-full hover:bg-primary/5 transition-all"
        >
          Call (801) 980-2583
        </a>
      </div>
    </div>
  </section>

  <!-- How Hard Is Utah's Water -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Image
            src={valveHeadImg}
            alt="Digital control valve and bypass on a Blue Logic tank, plumbed into a Utah home's water line"
            class="rounded-2xl shadow-2xl w-full object-cover aspect-4/3"
            widths={[400, 600, 800, 1100]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            quality={60}
            loading="lazy"
          />
          <p class="text-sm text-muted-foreground text-center mt-3 italic">
            A Blue Logic tank's digital control valve, installed in a Utah home.
          </p>
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Why Utah Water Is So Hard
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">
            The Wasatch Front sits above a geology rich in limestone and carbonate rock. As water
            moves through these formations on its way to reservoirs and aquifers, it dissolves
            calcium and magnesium, the minerals that cause hardness. By the time it reaches your
            tap, most Utah communities are dealing with water in the 15 to 25+ grains-per-gallon
            (GPG) range, placing it firmly in the "very hard" category.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            For context, water above 10.5 GPG is classified as very hard. Most of the US averages
            around 7 to 10 GPG. Much of the Wasatch Front runs significantly above that.
          </p>
          <a href="/utah-hard-water/" class="text-primary font-semibold hover:opacity-80 transition-opacity">
            Learn more about Utah hard water →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Hard Water Does -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        What Hard Water Does to Your Home and Family
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        Hard water is more than an inconvenience: it has real costs for Utah homeowners.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="impact-card">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Appliance Damage</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Mineral scale builds up inside water heaters, dishwashers, and washing machines.
            Scale makes water heaters work harder and can shorten the life of the appliances that
            use your water. In Utah's very hard water regions, scale builds up faster.
          </p>
        </div>
        <div class="impact-card">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Pipe and Fixture Scale</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Calcium deposits gradually narrow pipes and clog showerheads, faucet aerators, and
            fixture valves. The white residue on your shower doors and around your faucets is the
            visible evidence of minerals depositing every time water evaporates.
          </p>
        </div>
        <div class="impact-card">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Skin and Hair</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Hard water minerals can interfere with soap lathering and leave a residue on skin and
            hair after bathing. Many people notice drier skin and duller, less manageable hair in
            hard water areas. Softer water typically produces a noticeably different, and for most
            people better, bathing experience.
          </p>
        </div>
        <div class="impact-card">
          <h3 class="text-xl font-semibold mb-3 text-foreground">Dishes and Laundry</h3>
          <p class="text-muted-foreground text-sm leading-relaxed">
            Hard water reduces the effectiveness of detergents and soaps, requiring more product
            to achieve the same cleaning result. Dishes emerge from the dishwasher with a white
            film; fabrics washed in hard water can feel stiff and may show accelerated wear.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Softener Alone vs. Integrated System -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Is a Standalone Softener Enough for Utah Water?
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        An honest breakdown of what a softener addresses, and what it doesn't.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-primary">
              <th class="text-left py-3 px-4 text-foreground font-semibold">Water Quality Concern</th>
              <th class="py-3 px-4 text-center text-muted-foreground font-semibold">Softener</th>
              <th class="py-3 px-4 text-center text-primary font-semibold">Blue Logic Filtration</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground">Hard water / scale / spots</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ Yes</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ Yes</td>
            </tr>
            <tr class="border-b border-border bg-card">
              <td class="py-3 px-4 text-foreground">Chlorine smell and taste</td>
              <td class="py-3 px-4 text-center text-error">✗ No</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ Yes</td>
            </tr>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground">Sediment and rust</td>
              <td class="py-3 px-4 text-center text-error">✗ No</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ Yes</td>
            </tr>
            <tr class="border-b border-border bg-card">
              <td class="py-3 px-4 text-foreground">Total dissolved solids (TDS)</td>
              <td class="py-3 px-4 text-center text-error">✗ No</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ At the kitchen tap (included RO)</td>
            </tr>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground">PFAS / heavy metals / contaminants</td>
              <td class="py-3 px-4 text-center text-error">✗ No</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ At the kitchen tap (included RO)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-foreground">Drinking water taste improvement</td>
              <td class="py-3 px-4 text-center text-error">✗ No</td>
              <td class="py-3 px-4 text-center text-success font-bold">✓ Yes</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bg-primary/5 border border-primary/20 rounded-2xl p-6 md:p-8">
        <h3 class="font-semibold text-foreground mb-3">Blue Logic's honest recommendation:</h3>
        <p class="text-muted-foreground leading-relaxed">
          If your only concern is scale on fixtures and in appliances, the Blue Logic Softener may
          be all you need. If you're also concerned about what your family drinks and cooks with, or if
          your water has chlorine odor, visible discoloration, or a mineral taste, Blue Logic
          Filtration or the Blue Logic Purification System addresses those concerns in one
          installation.
          Your free water test will show you exactly what's in your water so you can make an
          informed decision, not a sales-driven one.
        </p>
      </div>

      <div class="text-center mt-8">
        <a
          href="/water-softener-vs-whole-home-filtration/"
          class="text-primary font-semibold hover:opacity-80 transition-opacity"
        >
          Full comparison: Softener vs. Filtration vs. RO →
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews max={6} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + Service Area -->
  <section class="bg-background py-12 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-serif mb-6 text-foreground">Related Pages</h2>
      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a href="/whole-home-reverse-osmosis-utah/" class="related-link">Whole-Home Reverse Osmosis</a>
        <a href="/whole-home-water-filtration/" class="related-link">Whole-Home Filtration</a>
        <a href="/water-softener-vs-whole-home-filtration/" class="related-link">Compare Options</a>
        <a href="/utah-hard-water/" class="related-link">Utah Hard Water Guide</a>
      </div>
      <p class="text-muted-foreground text-sm">
        Serving: Salt Lake City · Provo · Orem · Lehi · Sandy · Draper · Ogden · Layton · Bountiful · American Fork · Spanish Fork · Springville and surrounding Wasatch Front communities.
      </p>
    </div>
  </section>

  <!-- Form -->
  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Schedule Your Free Water Test
      </h2>
      <p class="text-lg text-muted-foreground text-center mb-10">
        A Blue Logic specialist will test your water at your kitchen sink and recommend whether
        the Blue Logic Softener or Blue Logic Filtration is the right fit. No cost, no obligation.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .impact-card {
    @apply bg-background p-6 rounded-2xl border border-border border-l-4 border-l-primary;
  }

  .related-link {
    @apply px-4 py-2 bg-background border border-border rounded-full text-sm text-primary font-medium hover:border-primary transition-colors;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
