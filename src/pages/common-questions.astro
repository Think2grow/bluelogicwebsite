---
import Layout from "../layouts/Layout.astro";
import { getFAQSchema, getBreadcrumbSchema } from "../utils/schema";
import { Image } from "astro:assets";
import cleanWaterSinkImg from "../assets/water_art/AdobeStock_706544309_clean_water_in_sink.jpeg";
import toddlerWaterImg from "../assets/water_art/AdobeStock_689029947_toddler_with_water.jpeg";
import OfferBanner from "../components/OfferBanner.astro";
import {
  PRICES,
  PRICE_NOTE,
  offerActive,
  usd,
} from "../data/offer";

export const prerender = true;

interface FAQ {
  question: string;
  answer: string;
}

const L = "class='text-primary hover:underline font-semibold'";
const showOffer = offerActive();

const financingAnswer =
  "Yes. Financing is available through Pinnacle Finance for qualifying homeowners, subject to credit approval. Checking your eligibility is a soft credit inquiry that does not affect your credit score." +
  (showOffer ? " See the current offer on this page for this year's financing promotion." : "") +
  " Your specialist can walk you through the options at your free water test.";

const faqs: FAQ[] = [
  {
    question:
      "How is the Blue Logic Purification System different from a regular filter or softener?",
    answer:
      `A softener treats hardness, and a filter treats what it was built to catch. The <a href='/the-system/' ${L}>Blue Logic Purification System</a> treats the whole home: Blue Logic Filtration in front softens and filters the water, reverse osmosis then purifies it, a 165-gallon food-grade storage tank holds it, and a Grundfos SCALA2 constant-pressure pump delivers it, so every tap in the home runs purified water at normal pressure, not just one faucet.`,
  },
  {
    question: "What does Blue Logic Filtration actually do?",
    answer:
      `Blue Logic Filtration softens and filters your water in one self-cleaning tank. You get soft water that ends scale and spots, chlorine and chloramine taste and odor gone at every tap, sediment and rust filtered out, protection for your plumbing, fixtures and appliances, and water that is gentler on skin and hair. It also helps reduce contaminants such as VOCs, pesticides, pharmaceuticals, microplastics and PFAS. Every Filtration system includes an under-sink reverse osmosis system for purified drinking water at the kitchen tap. <a href='/the-system/' ${L}>Learn how it works</a>.`,
  },
  {
    question: "Will this replace my water softener?",
    answer:
      "Yes. Blue Logic Filtration softens your water and filters it in the same tank, so it replaces a softener rather than sitting beside one. Like a softener, it uses salt to regenerate, so you'll keep the salt topped up. If hardness is your only concern, the Blue Logic Softener is our softening-only option.",
  },
  {
    question: "What kind of maintenance is required?",
    answer:
      "Minimal. You keep salt in the brine tank, and salt is available at large local retailers such as Costco and Walmart. Annual maintenance is standard and covers filter changes (for the under-sink RO and the Purification System) and a general system check. RO membranes are replaced periodically as part of that maintenance.",
  },
  {
    question: "How much does a Blue Logic system cost?",
    answer:
      `Blue Logic systems range from ${usd(PRICES.softener)} to $19,999 depending on your home and the outcome you want. The Blue Logic Softener is ${usd(PRICES.softener)}, Blue Logic Filtration (with under-sink RO) is ${usd(PRICES.filtration)}, and the Blue Logic Purification System is ${usd(PRICES.purification)}. ${PRICE_NOTE} Any non-standard work, such as long plumbing runs or significant drywall work, is discussed with you before any work is done. <a href='/free-water-test/' ${L}>Schedule your free water test for a transparent quote</a>.`,
  },
  {
    question: "How long does installation take?",
    answer:
      "It depends on the system and your home's layout, and we confirm the timeline with you before work begins. Systems are typically installed in the utility room, close to where the water main enters the home. Our professional installation partner handles the work with meticulous attention to detail.",
  },
  {
    question: "How much water is wasted during the RO process?",
    answer:
      "Blue Logic reverse osmosis runs at about 3 gallons of purified water for every 1 gallon sent to drain (up to 75% recovery). Blue Logic Filtration in front of the membrane is what makes that efficiency safe, because it softens and filters the water before it reaches the RO.",
  },
  {
    question: "Will this remove the minerals from my water?",
    answer:
      "Yes. Reverse osmosis removes dissolved solids, including the calcium and magnesium that cause hardness. That will not cause a nutritional deficiency: the vast majority of the calcium and magnesium your body needs comes from food, not water, and low-mineral water does not leach existing nutrients from the body.",
  },
  {
    question: "Do you serve my area?",
    answer:
      `Blue Logic serves Utah's Wasatch Front, <a href='/locations/' ${L}>including Salt Lake, Davis and Utah Counties, the Tooele Valley, and the Ogden and Weber metro</a>: Salt Lake City, Provo, Orem, Lehi, Sandy, Draper, Ogden, Layton, Bountiful, American Fork, Tooele, and surrounding communities. Enter your zip code when you schedule and we'll confirm the details for your address.`,
  },
  {
    question: "What contaminants does RO remove?",
    answer:
      "Reverse osmosis removes or reduces total dissolved solids, hardness, heavy metals including lead and arsenic, fluoride, nitrates, PFAS, pharmaceuticals, pesticides, microplastics, bacteria and viruses. For specific contaminant concerns, your free water test and your city's EWG data are the best starting points.",
  },
  {
    question: "How does Utah's hard water affect RO systems?",
    answer:
      `Utah has some of the hardest water in the country, and most Wasatch Front communities deliver water in the 10 to 25 grains-per-gallon range. That is why every Blue Logic Purification System puts Blue Logic Filtration in front of the RO: it removes hardness minerals before they reach the membrane, protecting it from scale. Without proper pre-treatment, hard water would scale and degrade an RO membrane quickly. <a href='/utah-hard-water/' ${L}>Learn more about Utah hard water</a>.`,
  },
  {
    question: "What warranty do you offer?",
    answer:
      "Blue Logic systems carry a 5-year warranty against defects in materials and workmanship, and installation workmanship is covered for 12 months. Consumables such as filters, cartridges, RO membranes, salt, and antiscalant are not covered. Your agreement and the Blue Logic Limited Warranty state the full terms. As a local company, we're here for ongoing support, not just for the sale.",
  },
  {
    question: "Can I install this myself to save money?",
    answer:
      "We strongly recommend professional installation. These systems require precise plumbing connections, pressure settings, and proper drain setup, and improper installation can lead to leaks, poor performance, or system damage that the warranty does not cover. Standard installation is included in the price.",
  },

  // Utah-specific and buyer-decision FAQs
  {
    question: "Do you offer financing?",
    answer: financingAnswer,
  },
  {
    question: "Do you work on well water systems?",
    answer:
      "Blue Logic's primary focus is homes on city water. Well water often needs additional pre-treatment (for example iron removal, pH adjustment, or bacterial testing) before a system can be designed. If you're on well water, mention it when you schedule your free water test, and your specialist will assess what your well needs.",
  },
  {
    question: "What is remineralization and do I need it?",
    answer:
      "Reverse osmosis removes dissolved minerals, including calcium and magnesium. Some people like to add trace minerals back for taste; this is called remineralization. It is not required for the system to work, and it is not needed for health, because most of the minerals your body uses come from food. Your specialist can discuss it at your water test if it matters to you.",
  },
  {
    question: "Can I start with filtration and add RO purification later?",
    answer:
      "Yes. Blue Logic systems are modular. Blue Logic Filtration works as a complete system on its own, and the reverse osmosis unit, 165-gallon storage tank, and constant-pressure pump can be added later without replacing it, because the Purification System uses the same Filtration tank in front of the RO. Your specialist will explain the upgrade path and cost difference at your water test.",
  },
  {
    question: "What happens if my system needs a repair after the warranty ends?",
    answer:
      "Blue Logic is a local Utah company, and we're not going anywhere. After the 5-year warranty ends, service and repairs are available on a per-visit basis. During the warranty, covered parts are replaced at no charge, and visits outside scheduled maintenance carry the standard $129 service call fee. Annual maintenance catches most issues before they become problems, and if something seems off, call us first: we'll try to solve it by phone and send a technician if needed.",
  },
  {
    question: "Does installing a whole-home system require a permit in Utah?",
    answer:
      "Requirements vary by city and by the scope of the installation. Your Blue Logic specialist will confirm permit requirements during the free water test site assessment, and we handle or advise on any permit requirements as part of the installation process.",
  },
  {
    question: "Will my water pressure drop after the RO system is installed?",
    answer:
      "No. The Blue Logic Purification System includes a Grundfos SCALA2 constant-pressure pump that delivers purified water to the home at normal pressure after the RO stage. Purified water is held in a 165-gallon food-grade storage tank, and homes that need more storage get additional 165-gallon tanks added as modules.",
  },
  {
    question: "What is the annual maintenance cost after installation?",
    answer:
      "The ongoing costs are salt, which you buy at large local retailers such as Costco or Walmart, and annual maintenance, which covers filter changes and a general system check. RO membranes are replaced periodically. Your specialist will give you the maintenance schedule and pricing for your system.",
  },
  {
    question: "How do I know if the system is working properly?",
    answer:
      "Blue Logic walks you through your system at installation. For most homeowners, the clearest signs are immediate: water tastes and smells different, scale stops forming on fixtures, and soap lathers more easily. Annual maintenance includes a general system check, and if something seems off in between, you can call or text Blue Logic directly. We're a local team, not a call center.",
  },
  {
    question: "What's the difference between Blue Logic and a Berkey or countertop gravity filter?",
    answer:
      "Countertop gravity filters like Berkey treat water at a single point, typically your kitchen, at a very slow flow rate. They require manual refilling and don't treat shower water, bath water, laundry water, or the water going into your appliances. Blue Logic's whole-home systems treat every tap and fixture in your house at full household flow. For whole-home protection against hard water, chlorine, and contaminants, a point-of-use gravity filter is not a substitute.",
  },
];

const siteUrl = "https://www.bluelogicwater.com";

const schemas = [
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "FAQ", url: "/common-questions/" },
  ]),
];
---

<Layout
  title="Water Treatment FAQs | Blue Logic Water, Utah"
  description="Answers to the most common questions Utah homeowners ask about whole-home reverse osmosis, water softeners, filtration systems, cost, installation, and maintenance."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-serif mb-4 text-foreground">
        Common Questions
      </h1>
      <p class="text-xl md:text-2xl text-muted-foreground">
        Everything you need to know about Blue Logic Water systems
      </p>
    </div>
  </section>

  <!-- Trust-building Image Section -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Image
            src={cleanWaterSinkImg}
            alt="Clear water pouring from a kitchen faucet into a glass"
            class="rounded-2xl shadow-xl w-full object-cover aspect-4/3"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={50}
          />
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Your Questions, Answered
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Investing in a water purification system is a big decision. We've
            compiled the most common questions from Utah homeowners to help you
            make an informed choice.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed">
            Still have questions? Our team of local water experts is here to
            help, with honest answers, not sales pressure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-lg text-muted-foreground">
          Have a question not answered here? <a
            href="/free-water-test/"
            class="text-primary font-semibold hover:underline">Contact us</a
          > and we'll be happy to help.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        {
          faqs.map((faq, index) => (
            <div
              class="faq-item"
              id={`faq-${faq.answer.replace(/\s+/g, "-").toLowerCase()}`}
            >
              <button
                class="faq-question"
                aria-expanded="false"
                aria-controls={`answer-${index}`}
              >
                <span>{faq.question}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id={`answer-${index}`}>
                <p
                  class="pb-6 text-muted-foreground leading-relaxed"
                  set:html={faq.answer}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <OfferBanner variant="full" />

  <!-- Family Safety Image Section -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Pure Water at Every Stage
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            From a baby's first sip to daily hydration, your family's water
            matters at every age. The Blue Logic Purification System delivers
            purified water to every tap, whether it's for drinking, cooking, or bathing.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed">
            That's the Blue Logic difference: complete peace of mind, not just
            at one tap.
          </p>
        </div>
        <div class="order-1 lg:order-2">
          <Image
            src={toddlerWaterImg}
            alt="Smiling toddler holding a glass of clear water"
            class="rounded-2xl shadow-xl w-full object-cover aspect-4/3"
            widths={[400, 600]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={50}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif mb-4 text-foreground">
        Still Have Questions?
      </h2>
      <p class="text-xl text-muted-foreground mb-8">
        Schedule a free consultation with our team
      </p>
      <a href="/free-water-test/" class="btn btn-primary btn-lg w-full md:w-auto">Get in Touch</a>
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";
  .faq-item {
    @apply border-b border-border;
  }

  .faq-question {
    @apply w-full flex justify-between items-center py-6 bg-transparent border-none cursor-pointer text-left text-lg md:text-xl font-semibold text-foreground transition-colors duration-200;
  }

  .faq-question:hover {
    @apply text-primary;
  }

  .faq-icon {
    @apply text-2xl text-primary font-light transition-transform duration-300 shrink-0 ml-4;
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    @apply rotate-45;
  }

  .faq-answer {
    @apply max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out;
  }

  .faq-answer.open {
    transition: max-height 0.3s ease-in;
  }
</style>

<script>
  function setupAccordion() {
    const faqButtons = document.querySelectorAll(".faq-question");

    faqButtons.forEach((button) => {
      // Remove existing listeners to prevent duplicates
      const newButton = button.cloneNode(true) as HTMLButtonElement;
      button.replaceWith(newButton);

      newButton.addEventListener("click", () => {
        const isExpanded = newButton.getAttribute("aria-expanded") === "true";
        const answerId = newButton.getAttribute("aria-controls");
        const answer = answerId ? document.getElementById(answerId) : null;

        // Close all other answers
        document.querySelectorAll(".faq-question").forEach((otherButton) => {
          if (otherButton !== newButton) {
            otherButton.setAttribute("aria-expanded", "false");
            const otherAnswerId = otherButton.getAttribute("aria-controls");
            const otherAnswer = otherAnswerId
              ? document.getElementById(otherAnswerId)
              : null;
            if (otherAnswer) {
              otherAnswer.style.maxHeight = "0";
              otherAnswer.classList.remove("open");
            }
          }
        });

        // Toggle current answer
        if (!isExpanded && answer) {
          answer.style.maxHeight = answer.scrollHeight + "px";
          answer.classList.add("open");
        } else if (answer) {
          answer.style.maxHeight = "0";
          answer.classList.remove("open");
        }
        newButton.setAttribute("aria-expanded", String(!isExpanded));
      });
    });
  }

  // Run on initial load
  setupAccordion();

  // Run on every View Transition navigation
  document.addEventListener("astro:page-load", setupAccordion);
</script>
