---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import ProductExplosion from "../components/ProductExplosion.astro";
import Reviews from "../components/Reviews.astro";
import OfferBanner from "../components/OfferBanner.astro";
import { SYSTEMS } from "../data/offer";
import { getBreadcrumbSchema, getAggregateRatingSchema } from "../utils/schema";
import { Image, getImage } from "astro:assets";
import utilityRoomSystemImg from "../assets/real/installs/purification-room-storage-tanks.jpg";
import VslHero from "../components/VslHero.astro";
import vslPoster from "../assets/vsl/jared-owner-intro.jpg";
import { getVslSchema } from "../data/vsl";

export const prerender = true;

// Generate homepage-specific schema
const siteUrl = Astro.site?.toString() || "https://bluelogicwater.com";

const [softener, filtration] = SYSTEMS;

const vslThumb = await getImage({ src: vslPoster, width: 1280, format: "jpg" });
const vslThumbUrl = new URL(vslThumb.src, siteUrl).toString();

const schemas = [
  getBreadcrumbSchema(siteUrl, [{ name: "Home", url: "/" }]),
  getAggregateRatingSchema(`${siteUrl}/`),
  getVslSchema(new URL("/", siteUrl).toString(), vslThumbUrl),
];
---

<Layout
  title="Water Treatment Utah | Blue Logic Water | Wasatch Front"
  description="Whole-home reverse osmosis, filtration and water softeners for Utah's Wasatch Front. Out-the-door pricing with installation and tax included. Free in-home water test. Serving Ogden to Springville."
  schema={schemas}
>
  <!-- Hero: owner video + how to get started -->
  <VslHero />

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-serif mb-8 text-foreground">
        Local Water Treatment, Priced Honestly
      </h2>
      <p class="text-lg leading-relaxed text-muted-foreground mb-6 max-w-3xl mx-auto">
        Blue Logic installs professional-grade <a href="/whole-home-reverse-osmosis-utah/" class="text-primary hover:underline font-semibold">whole-home reverse osmosis systems</a>, <a href="/whole-home-water-filtration/" class="text-primary hover:underline font-semibold">whole-home filtration</a>, and <a href="/water-softener-utah/" class="text-primary hover:underline font-semibold">water softeners</a> across Utah's Wasatch Front, with out-the-door pricing that includes standard installation and tax.
      </p>
      <p class="text-lg leading-relaxed text-muted-foreground max-w-3xl mx-auto">
        Every system starts with a <a href="/free-water-test/" class="text-primary hover:underline font-semibold">free in-home water test</a>. We serve <a href="/locations/salt-lake-city/" class="text-primary hover:underline font-semibold">Salt Lake City</a>, <a href="/locations/provo/" class="text-primary hover:underline font-semibold">Provo</a>, <a href="/locations/lehi/" class="text-primary hover:underline font-semibold">Lehi</a>, <a href="/locations/draper/" class="text-primary hover:underline font-semibold">Draper</a>, and the full Wasatch Front.
      </p>
    </div>
  </section>

  <!-- Current offer -->
  <OfferBanner variant="full" />

  <!-- Services Hub -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Water Treatment Systems for Utah Homes
      </h2>
      <p class="text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        Three levels of water treatment, each built on Blue Logic softening and adding more from there.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <a href="/water-softener-utah/" class="service-card group">
          <div class="service-icon">💧</div>
          <h3 class="text-xl font-semibold text-foreground mb-2 group-hover:text-primary transition-colors">Blue Logic Softener</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">{softener.summary} Protects your water heater, appliances, and plumbing.</p>
          <span class="text-primary text-sm font-semibold">Learn more →</span>
        </a>
        <a href="/whole-home-water-filtration/" class="service-card group border-primary/30">
          <div class="service-icon">🔵</div>
          <h3 class="text-xl font-semibold text-foreground mb-2 group-hover:text-primary transition-colors">Blue Logic Filtration</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">{filtration.summary} Chlorine and chloramine taste and odor gone at every tap.</p>
          <span class="text-primary text-sm font-semibold">Learn more →</span>
        </a>
        <a href="/whole-home-reverse-osmosis-utah/" class="service-card group bg-primary/5 border-primary/40">
          <div class="service-icon">✨</div>
          <div class="text-xs font-bold uppercase tracking-wide text-primary mb-2">Most Complete</div>
          <h3 class="text-xl font-semibold text-foreground mb-2 group-hover:text-primary transition-colors">Blue Logic Purification</h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-4">Whole-home reverse osmosis: Blue Logic Filtration in front, then RO, 165-gallon storage, and constant pressure. Purified water at every tap, reducing arsenic, PFAS, and heavy metals.</p>
          <span class="text-primary text-sm font-semibold">Learn more →</span>
        </a>
      </div>
      <div class="text-center">
        <a href="/water-softener-vs-whole-home-filtration/" class="text-primary font-semibold text-sm hover:opacity-80 transition-opacity">
          Not sure which is right for your home? Compare all options →
        </a>
      </div>
    </div>
  </section>

  <!-- Family Trust Section with Image -->
  <section class="bg-card py-16 md:py-24 px-4 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Purified Water at Every Tap
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            The Blue Logic Purification System treats all of the water entering your
            home, not just the kitchen faucet. Drinking, cooking, showers and baths
            all get the same purified water.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-8">
            It starts with Blue Logic Filtration, then reverse osmosis, 165-gallon
            storage and a constant-pressure pump, so every faucet gets
            <a
              href="/the-system/"
              class="text-primary hover:underline font-semibold"
              >purified water at steady pressure</a
            >.
          </p>
          <a
            href="/the-system/"
            class="inline-flex w-full justify-center px-5 py-3 rounded-full bg-primary text-primary-foreground font-semibold text-lg shadow-md border border-primary/30 transition-all md:w-auto md:bg-transparent md:text-primary md:shadow-none md:border-0 md:px-0 md:py-0 md:hover:opacity-80 md:transition-opacity"
          >
            Learn How It Works →
          </a>
        </div>
        <div class="order-1 lg:order-2">
          <div class="relative">
            <Image
              src={utilityRoomSystemImg}
              alt="Blue Logic Purification System in a Utah home's mechanical room: purified water storage tanks, Filtration pretreatment tank, reverse osmosis unit and brine tank"
              class="rounded-2xl shadow-2xl w-full object-cover aspect-4/5"
              widths={[400, 600, 800, 1100]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              quality={60}
              loading="lazy"
            />
            <div
              class="absolute -bottom-4 -right-4 bg-primary text-primary-foreground px-6 py-3 rounded-xl font-semibold shadow-lg"
            >
              Water You Can Trust
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2
        class="text-3xl md:text-4xl font-serif text-center mb-12 text-foreground"
      >
        The Blue Logic Difference
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="text-center p-8 bg-background rounded-2xl">
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-primary">
            Out-the-Door Pricing
          </h3>
          <p class="text-muted-foreground">Standard installation and tax included in every price</p>
        </div>
        <div class="text-center p-8 bg-background rounded-2xl">
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-primary">
            Modular by Design
          </h3>
          <p class="text-muted-foreground">
            Start with softening or Filtration and add reverse osmosis later
          </p>
        </div>
        <div class="text-center p-8 bg-background rounded-2xl">
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-primary">
            5-Year Warranty
          </h3>
          <p class="text-muted-foreground">
            On defects in materials and workmanship, plus 10 years on the media inside the treatment tank
          </p>
        </div>
      </div>
      <a
        href="/the-system/"
        class="inline-flex w-full justify-center px-5 py-3 rounded-full bg-primary text-primary-foreground font-semibold text-lg shadow-md border border-primary/30 transition-all md:w-auto md:bg-transparent md:text-primary md:shadow-none md:border-0 md:px-0 md:py-0 md:hover:opacity-80 md:transition-opacity"
      >
        Explore the System →
      </a>
    </div>
  </section>

  <!-- Product Explosion Animation (Task 3.1) -->
  <ProductExplosion
    title="Inside the Purification System"
    subtitle="Five stages, from Blue Logic Filtration to constant pressure, and what each one does"
  />

  <!-- Whole-home + local water data -->
  <section class="bg-background py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl mx-auto text-center mb-16">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-4 text-foreground">
            Why the Whole Home Matters
          </h2>
          <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
            Showers, baths and laundry use far more water than the kitchen tap.
            An under-sink system covers what you drink; whole-home treatment
            covers everything else too.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            That is why every Blue Logic system treats your water where it enters
            the house.
          </p>
        </div>
      </div>

      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-serif mb-4 text-foreground">
          What's in the Water Where You Live
        </h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          Utah utilities meet federal limits, but their own test results show several contaminants well above the health guidelines published by the Environmental Working Group. A few examples from communities we serve:
        </p>
      </div>

      <!-- Location Trust Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <a
          href="/locations/salt-lake-city/"
          class="group p-4 md:p-6 bg-card rounded-xl border border-border hover:border-primary/30 transition-all hover:shadow-md"
        >
          <div class="text-sm text-muted-foreground mb-1">Salt Lake City</div>
          <div
            class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors"
          >
            Arsenic: 135 times the health guideline
          </div>
        </a>
        <a
          href="/locations/draper/"
          class="group p-4 md:p-6 bg-card rounded-xl border border-border hover:border-primary/30 transition-all hover:shadow-md"
        >
          <div class="text-sm text-muted-foreground mb-1">Draper</div>
          <div
            class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors"
          >
            Arsenic: 450 times the health guideline
          </div>
        </a>
        <a
          href="/locations/cottonwood-heights/"
          class="group p-4 md:p-6 bg-card rounded-xl border border-border hover:border-primary/30 transition-all hover:shadow-md"
        >
          <div class="text-sm text-muted-foreground mb-1">Cottonwood Heights</div>
          <div
            class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors"
          >
            PFAS: 404 times the health guideline
          </div>
        </a>
        <a
          href="/locations/sandy/"
          class="group p-4 md:p-6 bg-card rounded-xl border border-border hover:border-primary/30 transition-all hover:shadow-md"
        >
          <div class="text-sm text-muted-foreground mb-1">Sandy</div>
          <div
            class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors"
          >
            Haloacetic acids (HAA5): 306 times the health guideline
          </div>
        </a>
      </div>

      <div class="text-center mt-8">
        <a
          href="/locations/"
          class="inline-flex w-full justify-center px-5 py-3 rounded-full bg-primary text-primary-foreground font-semibold shadow-md border border-primary/30 transition-all md:w-auto md:bg-transparent md:text-primary md:shadow-none md:border-0 md:px-0 md:py-0 md:hover:text-primary/80"
        >
          View All Service Areas →
        </a>
      </div>

    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews max={6} />
      <div class="text-center mt-10">
        <a
          href="https://maps.app.goo.gl/SRHLVoVec7bkQx566"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary font-semibold hover:opacity-80 transition-opacity text-sm"
        >
          See all reviews on Google →
        </a>
      </div>
    </div>
  </section>

  <LeadForm />
</Layout>

<style>
  @reference "../styles/global.css";
  .service-card {
    @apply flex flex-col bg-background border-2 border-border rounded-2xl p-6 no-underline hover:border-primary hover:-translate-y-1 transition-all duration-200 shadow-sm hover:shadow-md;
  }
  .service-icon {
    @apply text-3xl mb-3;
  }
</style>
