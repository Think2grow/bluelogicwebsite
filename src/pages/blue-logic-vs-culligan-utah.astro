---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import { getFAQSchema, getBreadcrumbSchema } from "../utils/schema";
import { PRICES, usd } from "../data/offer";

const priceRange = `${usd(PRICES.softener)} to $19,999`;

export const prerender = true;

const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "Culligan offered me a rental or lease program. Is that a good deal?",
    answer: "It depends on the total cost. Before signing any rental or lease, ask for the total cost of the agreement over its full term, what happens at the end of the term, who owns the equipment, and what it costs to cancel or move. Then compare that to buying. Blue Logic systems are purchased, not rented, and range from $2,999 to $19,999 out the door. You own the system from day one, and financing is available through Pinnacle Finance for qualifying homeowners.",
  },
  {
    question: "Culligan is a big national brand. Doesn't that mean better quality?",
    answer: "Brand recognition and installation quality are different things, so judge any quote on the system, the installation and the service behind it. Ask who owns and operates the local office you are dealing with and who will install your system. Blue Logic is a family-owned Utah company: co-owner Jared designs your system and oversees the installation, and you call Blue Logic directly for support.",
  },
  {
    question: "Does Blue Logic require a service contract?",
    answer: "No. Blue Logic does not require an ongoing service contract. Annual maintenance, which covers filter changes and a general system check, is standard and scheduled for you. Visits outside scheduled maintenance carry a $129 service call fee.",
  },
  {
    question: "How is Blue Logic's sales process different?",
    answer: "Blue Logic's free water test is built around information, not a same-day close. We test your water, show you what's in it based on real measurements, give you a transparent written quote, and you take it home to decide at your own pace.",
  },
  {
    question: "Can I bring a Culligan quote to compare?",
    answer: "Yes. Bring any written quote to your free Blue Logic water test and we'll compare it with ours line by line: what each system treats, the full installed price, the warranty, and what ongoing service costs.",
  },
];

const schemas = [
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Blue Logic vs. Culligan Utah", url: "/blue-logic-vs-culligan-utah/" },
  ]),
];
---

<Layout
  title="Blue Logic vs. Culligan Utah | Before You Sign, Read This"
  description="Got a Culligan quote for Utah water treatment? Know what to ask about rentals, leases, service terms and who installs before signing. Compare it with a Blue Logic quote at a free water test."
  schema={schemas}
>
  <section class="hero-gradient py-20 md:py-24 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Utah Water Treatment · Comparison Guide
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Before You Sign With Culligan, Read This First
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
        If you're considering Culligan, or you're already holding a Culligan quote, here's what
        to ask before you commit, and how Blue Logic answers the same questions.
      </p>
    </div>
  </section>

  <section class="bg-primary/5 border-y border-primary/20 py-6 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-muted-foreground text-center">
        <strong class="text-foreground">What this page covers:</strong> Blue Logic's verified specs and what to ask Culligan before signing.
        We make no claims about Culligan's pricing or terms. Bring any written quote to your free water test and we'll compare it with ours.
      </p>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="callout-box mb-12">
        <h2 class="text-2xl font-serif mb-4 text-foreground">Rent, Lease or Buy: Know the Total Cost</h2>
        <p class="text-muted-foreground leading-relaxed mb-4">
          If a quote is a rental or lease, the monthly payment is only part of the picture. Ask for
          the total cost over the full term, who owns the equipment at the end, and what happens if
          you move or cancel.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          Blue Logic sells systems outright, so you own yours from the day it's installed. Pay up
          front, or finance through Pinnacle Finance if you qualify. There's no lease term and no
          question about what happens if you move.
        </p>
      </div>

      <div class="callout-box mb-12">
        <h2 class="text-2xl font-serif mb-4 text-foreground">Who Is Accountable for Your System</h2>
        <p class="text-muted-foreground leading-relaxed mb-4">
          With any national brand, ask who owns and operates the local office you're dealing with,
          who will physically install your system, and who you call for service years from now.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          Blue Logic is a family-owned Utah company. Co-owner Jared designs the system for your
          home's specific water profile and oversees the installation, which our professional
          installation partner performs. When you need support, you call Blue Logic directly.
        </p>
      </div>

      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">Blue Logic's Verified System Specs</h2>
      <p class="text-sm text-muted-foreground text-center mb-8">Ask Culligan the same questions and compare the written answers side by side.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
        {[
          { label: "Ownership model", value: "You own it", note: "Purchased, not rented or leased. Yours from day one." },
          { label: "System price range", value: priceRange, note: "Out the door: standard installation and tax included, confirmed in writing at your free water test." },
          { label: "Storage tank materials", value: "NSF/ANSI and FDA compliant", note: "The Purification System stores purified water in a 165-gallon food-grade tank built from NSF/ANSI and FDA compliant materials." },
          { label: "Warranty", value: "5 years on defects", note: "Covers defects in materials and workmanship; consumables such as filters, RO membranes and salt are excluded. Installation workmanship is covered for 12 months." },
          { label: "Service contract required", value: "No", note: "Annual maintenance (filter changes and a system check) is standard and scheduled for you. No ongoing service contract." },
          { label: "Financing", value: "Pinnacle Finance", note: "For qualifying homeowners, subject to credit approval. Checking eligibility is a soft credit inquiry." },
          { label: "Under-sink RO", value: "Included with Filtration", note: "Every Blue Logic Filtration system includes an under-sink reverse osmosis system at the kitchen tap." },
          { label: "Who is accountable", value: "Owner-led", note: "Co-owner Jared designs your system and oversees installation by our professional installation partner." },
        ].map((item) => (
          <div class="spec-card">
            <div class="flex justify-between items-start gap-4 mb-2">
              <span class="font-semibold text-foreground">{item.label}</span>
              <span class="text-primary font-bold shrink-0">{item.value}</span>
            </div>
            <p class="text-xs text-muted-foreground">{item.note}</p>
          </div>
        ))}
      </div>

      <div class="bg-card border border-border rounded-2xl p-6 md:p-8">
        <h2 class="text-2xl font-serif mb-4 text-foreground">Questions to Ask Culligan Before Signing</h2>
        <ul class="space-y-3 text-muted-foreground">
          {[
            "Is this a purchase, a rental, or a lease? What is the total cost over 10 years?",
            "If I sell my home or move, what happens to the system and the contract?",
            "What does the service contract require, and what does it cost annually?",
            "Which components carry NSF/ANSI certification or compliance, to which standard, and can I see the documentation?",
            "Who physically performs the installation, and who do I call for service?",
            "What is the full installed price in writing, including all components and labor?",
          ].map((q) => (
            <li class="flex gap-3">
              <span class="text-primary font-bold shrink-0 mt-0.5">→</span>
              <span>{q}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews compact={true} heading="What Utah Homeowners Say About Blue Logic" />
    </div>
  </section>

  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-4 text-foreground">
        Get a Second Opinion, No Pressure
      </h2>
      <p class="text-muted-foreground text-center mb-10">
        Blue Logic's free water test measures exactly what's in your water and gives you a
        transparent written quote. If you already have a Culligan quote, bring it and we'll compare
        the two with you. You leave with both quotes and make the call at your own pace.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .hero-gradient {
    @apply bg-linear-to-br from-background to-card;
  }

  .callout-box {
    @apply bg-card border-l-4 border-primary rounded-r-2xl p-6 md:p-8;
  }

  .spec-card {
    @apply bg-card p-5 rounded-xl border border-border;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
