---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import Reviews from "../components/Reviews.astro";
import OfferBanner from "../components/OfferBanner.astro";
import { getServiceSchema, getFAQSchema, getBreadcrumbSchema, getAggregateRatingSchema } from "../utils/schema";
import { Image } from "astro:assets";
import dirtyCleanGlassesImg from "../assets/water_art/AdobeStock_259519171_dirty_water_clean_water_glasses.jpeg";
import filtrationTankImg from "../assets/WH Filtration Product.png";
import { PRICES, PRICE_NOTE, WARRANTY, usd } from "../data/offer";

export const prerender = true;

const siteUrl = "https://www.bluelogicwater.com";

const faqs = [
  {
    question: "How long does a whole-home RO installation take in a Utah home?",
    answer: "It depends on your home's layout. Systems are usually installed in the utility room, and we need access to the water main inside the home. Your specialist looks at the installation space during the free water test and gives you a specific timeline before you commit.",
  },
  {
    question: "Does a whole-home reverse osmosis system work with Utah's hard water?",
    answer: "Yes. Many Wasatch Front homes have water in the 10 to 25+ grains per gallon range. Every Blue Logic Purification System puts Blue Logic Filtration in front of the reverse osmosis: it softens the water and takes out chlorine, chloramine and sediment, then a sediment pre-filter catches fine particles. That pre-treatment protects the RO membrane and is what lets the system run at about 3 gallons of purified water for every 1 gallon sent to drain.",
  },
  {
    question: "Will the RO system reduce my home's water pressure?",
    answer: "No. Purified water is held in a 165-gallon food-grade storage tank, and a Grundfos SCALA2 constant-pressure pump sends it to every tap at steady household pressure. Homes that use more water add a second 165-gallon tank, or more, as a module.",
  },
  {
    question: "How much does a Blue Logic Purification System cost?",
    answer: `The Blue Logic Purification System is ${usd(PRICES.purification)} out the door, with standard installation and tax included. Homes that need more storage add 165-gallon tank modules, and any non-standard work (such as long runs or significant drywall work) is discussed and priced at your consult before any work is done.`,
  },
  {
    question: "How much water does the system waste?",
    answer: "Blue Logic's system produces about 3 gallons of purified water for every 1 gallon sent to drain (up to 75% recovery). The Filtration in front is what makes that ratio safe for the RO membrane.",
  },
  {
    question: "What maintenance does a whole-home RO system require?",
    answer: `You keep salt in the Filtration brine tank (available at stores like Costco and Walmart). Annual maintenance covers filter changes and a general system check, and RO membranes are replaced on a regular schedule. ${WARRANTY}`,
  },
  {
    question: "Are the system components certified?",
    answer: "The purified-water storage tank is BPA-free and built from NSF/ANSI and FDA compliant materials. Ask your specialist for component documentation at your free water test appointment.",
  },
  {
    question: "Can I start with filtration and add RO later?",
    answer: "Yes. Blue Logic systems are modular. Many homes start with Blue Logic Filtration (whole-home softening and filtration in one tank, plus an under-sink RO at the kitchen tap) and add the reverse osmosis, storage tank and constant-pressure pump later. The Filtration you already own becomes the pre-treatment. Your specialist will explain both options at your water test.",
  },
];

const schemas = [
  getServiceSchema(
    `${siteUrl}/whole-home-reverse-osmosis-utah/`,
    "Whole-Home Reverse Osmosis System Installation, Utah",
    `Whole-home reverse osmosis installation across Utah's Wasatch Front. The Blue Logic Purification System puts Blue Logic Filtration in front, then a sediment pre-filter, reverse osmosis, 165-gallon food-grade storage and a Grundfos SCALA2 constant-pressure pump, for purified water at every tap. ${usd(PRICES.purification)} out the door, installation and tax included.`,
  ),
  getFAQSchema(faqs),
  getBreadcrumbSchema(siteUrl, [
    { name: "Home", url: "/" },
    { name: "Whole-Home Reverse Osmosis Utah", url: "/whole-home-reverse-osmosis-utah/" },
  ]),
  getAggregateRatingSchema(`${siteUrl}/whole-home-reverse-osmosis-utah/`),
];
---

<Layout
  title="Whole Home Reverse Osmosis Utah | Blue Logic Water"
  description={`Whole-home reverse osmosis for Utah's Wasatch Front: purified water at every tap at normal pressure, about 3 gallons purified per 1 to drain. ${usd(PRICES.purification)} out the door. Free in-home water test.`}
  schema={schemas}
>
  <!-- Hero -->
  <section class="hero-gradient py-20 md:py-28 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-4">
        Wasatch Front · Weber · Davis · Salt Lake · Utah · Tooele Counties
      </p>
      <h1 class="text-4xl md:text-5xl font-serif mb-6 text-foreground leading-tight">
        Whole-Home Reverse Osmosis Systems for Utah Homes
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto mb-8 leading-relaxed">
        The Blue Logic Purification System puts purified reverse osmosis water at every tap in
        your home, at normal water pressure. {usd(PRICES.purification)} out the door. {PRICE_NOTE}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/free-water-test/"
          class="inline-block bg-primary text-primary-foreground font-semibold text-lg px-8 py-4 rounded-full shadow-lg hover:bg-primary/90 transition-all"
        >
          Schedule Free Water Test →
        </a>
        <a
          href="tel:+18019802583"
          class="inline-block border-2 border-primary text-primary font-semibold text-lg px-8 py-4 rounded-full hover:bg-primary/5 transition-all"
        >
          Call (801) 980-2583
        </a>
      </div>
    </div>
  </section>

  <!-- Offer Banner -->
  <OfferBanner />

  <!-- Why Utah Needs Whole-Home RO -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Why Utah Homes Need More Than a Softener
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">
            Utah has some of the hardest water in the United States. The carbonate rock geology across
            the Wasatch Front produces water heavily laden with calcium and magnesium, with hardness
            commonly in the 10 to 25+ grains per gallon range across Salt Lake, Utah, Davis, and
            Weber Counties.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-4">
            A traditional water softener addresses hardness minerals, but leaves chlorine, chloramine,
            dissolved solids, and other contaminants untouched. Whole-home reverse osmosis pushes
            water through a semi-permeable membrane that removes contaminants larger than about
            0.0001 micron.
          </p>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            The result: purified water with far lower total dissolved solids (TDS) at every tap in
            your home (kitchen, bathrooms, laundry, and appliances), not just at a single under-sink
            faucet.
          </p>
          <a href="/utah-water-quality/" class="text-primary font-semibold hover:opacity-80 transition-opacity">
            Learn more about Utah water quality →
          </a>
        </div>
        <div>
          <Image
            src={dirtyCleanGlassesImg}
            alt="A glass of cloudy, sediment-filled water beside a glass of clear water"
            class="rounded-2xl shadow-2xl w-full object-cover aspect-4/3"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={60}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- How the System Works -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        How the Blue Logic Purification System Works
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-3xl mx-auto mb-12">
        Five stages work together. Stage 1 is Blue Logic Filtration, which also works on its own
        as a whole-home system. Stages 2 to 5 add reverse osmosis purity to every tap.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-12">
        <div class="stage-card">
          <div class="stage-number">1</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">Softening &amp; Filtration</h3>
          <span class="stage-badge">Blue Logic Filtration</span>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            One self-cleaning tank softens the water and takes out chlorine, chloramine, sediment,
            and rust before it reaches the RO. It protects the membrane and also works on its own
            as Blue Logic Filtration.
          </p>
        </div>

        <div class="stage-card">
          <div class="stage-number">2</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">Sediment Pre-Filter</h3>
          <span class="stage-badge stage-badge-purification">Purification</span>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            A 5-micron sediment filter in a full-flow housing catches fine particles, so the RO
            membrane only sees clean, conditioned water.
          </p>
        </div>

        <div class="stage-card">
          <div class="stage-number">3</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">Reverse Osmosis</h3>
          <span class="stage-badge stage-badge-purification">Purification</span>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            A semi-permeable membrane reduces dissolved solids, heavy metals including lead and
            arsenic, fluoride, nitrates, and PFAS. It makes about 3 gallons of purified water for
            every 1 gallon sent to drain.
          </p>
        </div>

        <div class="stage-card">
          <div class="stage-number">4</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">165-Gallon Storage</h3>
          <span class="stage-badge stage-badge-purification">Purification</span>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            Purified water waits in a food-grade, BPA-free tank built from NSF/ANSI and FDA
            compliant materials. Homes that use more water add a second tank, or more, as a module.
          </p>
        </div>

        <div class="stage-card">
          <div class="stage-number">5</div>
          <h3 class="text-lg font-semibold mb-3 text-foreground">Constant Pressure</h3>
          <span class="stage-badge stage-badge-purification">Purification</span>
          <p class="text-sm text-muted-foreground mt-3 leading-relaxed">
            A Grundfos SCALA2 variable-speed pump regulates pressure automatically and sends
            purified water to every fixture at steady household pressure.
          </p>
        </div>
      </div>

      <div class="bg-primary/5 border border-primary/20 rounded-2xl p-6 md:p-8 text-center max-w-3xl mx-auto">
        <p class="font-semibold text-foreground">
          The Filtration in front isn't optional. It protects the RO membrane from Utah's hard
          water, and it is what makes running at about 3 gallons purified for every 1 to drain
          safe for the membrane. That's why every Blue Logic Purification System starts with
          Blue Logic Filtration.
        </p>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        What You Get With Blue Logic Purification
      </h2>
      <p class="text-lg text-muted-foreground text-center max-w-2xl mx-auto mb-10">
        Use these details to compare against any written quote you receive from other Utah water
        treatment companies.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-primary">
              <th class="text-left py-3 px-4 text-foreground font-semibold">Blue Logic Purification System</th>
              <th class="py-3 px-4 text-primary font-semibold text-center">What's Included</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground font-medium">Price</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">{usd(PRICES.purification)} out the door, installation and tax included</td>
            </tr>
            <tr class="border-b border-border bg-card">
              <td class="py-3 px-4 text-foreground font-medium">Equipment</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">Blue Logic Filtration, sediment pre-filter, RO, 165-gallon storage, Grundfos SCALA2 pump</td>
            </tr>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground font-medium">Water efficiency</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">About 3 gallons purified for every 1 to drain</td>
            </tr>
            <tr class="border-b border-border bg-card">
              <td class="py-3 px-4 text-foreground font-medium">Storage</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">165-gallon tanks, more added as modules when needed</td>
            </tr>
            <tr class="border-b border-border">
              <td class="py-3 px-4 text-foreground font-medium">Warranty</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">5 years on defects in materials and workmanship; 12 months on installation workmanship</td>
            </tr>
            <tr class="border-b border-border bg-card">
              <td class="py-3 px-4 text-foreground font-medium">Financing</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">Pinnacle Finance, approved credit; checking eligibility is a soft credit inquiry</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-foreground font-medium">Free in-home water test</td>
              <td class="py-3 px-4 text-center text-primary font-semibold">Yes, no cost and no obligation</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-muted-foreground text-center mt-4 italic">
        Consumables such as filters, RO membranes and salt are not covered by the warranty. Any
        non-standard installation work is discussed and priced at your consult before work begins.
      </p>

      <div class="text-center mt-8">
        <a
          href="/free-water-test/"
          class="inline-block bg-primary text-primary-foreground font-semibold text-lg px-8 py-4 rounded-full shadow hover:bg-primary/90 transition-all"
        >
          Schedule Your Free Water Test →
        </a>
      </div>
    </div>
  </section>

  <!-- What the System Is Not For -->
  <section class="bg-card py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-serif text-center mb-6 text-foreground">
        What to Know Before You Schedule
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-background rounded-xl p-6 border border-border">
          <h3 class="font-semibold text-foreground mb-3">Best suited for:</h3>
          <ul class="space-y-2 text-muted-foreground text-sm">
            <li class="flex gap-2"><span class="text-primary">·</span> Single-family homes on municipal water</li>
            <li class="flex gap-2"><span class="text-primary">·</span> New construction and existing homes</li>
            <li class="flex gap-2"><span class="text-primary">·</span> Homes with a utility room, garage, or basement for the system</li>
            <li class="flex gap-2"><span class="text-primary">·</span> Homeowners replacing bottled water dependency</li>
          </ul>
        </div>
        <div class="bg-background rounded-xl p-6 border border-border">
          <h3 class="font-semibold text-foreground mb-3">Requires custom assessment:</h3>
          <ul class="space-y-2 text-muted-foreground text-sm">
            <li class="flex gap-2"><span class="text-muted-foreground">·</span> Well water (additional pre-treatment typically required)</li>
            <li class="flex gap-2"><span class="text-muted-foreground">·</span> Multi-family buildings or commercial properties</li>
            <li class="flex gap-2"><span class="text-muted-foreground">·</span> Homes with non-standard plumbing configurations</li>
          </ul>
          <p class="text-xs text-muted-foreground mt-4 italic">Your free water test includes a site assessment, and we'll tell you exactly what works for your home.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech specs -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Image
            src={filtrationTankImg}
            alt="Blue Logic Whole-Home Filtration tank and brine tank, the pre-treatment that sits in front of the reverse osmosis"
            class="w-full object-contain aspect-3/4"
            widths={[400, 600]}
            sizes="(max-width: 768px) 100vw, 50vw"
            quality={70}
          />
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-foreground">
            Modular, Sized to Your Home
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Blue Logic equipment is modular and installed on site, usually in the utility room.
            We size every system to the home, and a home that needs more purified-water storage
            simply adds another 165-gallon tank.
          </p>
          <div class="space-y-4">
            <div class="spec-row">
              <span class="font-semibold text-foreground">Pre-treatment</span>
              <span class="text-primary font-semibold text-right">Blue Logic Filtration + 5-micron sediment pre-filter</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Membrane</span>
              <span class="text-primary font-semibold text-right">Removes contaminants larger than about 0.0001 micron</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Water efficiency</span>
              <span class="text-primary font-semibold text-right">About 3 gallons purified per 1 to drain (up to 75% recovery)</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Storage</span>
              <span class="text-primary font-semibold text-right">165 gallons per tank, more tanks added as modules</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Tank materials</span>
              <span class="text-primary font-semibold text-right">BPA-free, NSF/ANSI and FDA compliant materials</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Pressure</span>
              <span class="text-primary font-semibold text-right">Grundfos SCALA2 constant-pressure pump</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Warranty</span>
              <span class="text-primary font-semibold text-right">5-year system; 12-month installation</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Financing</span>
              <span class="text-primary font-semibold text-right">Pinnacle Finance, approved credit</span>
            </div>
            <div class="spec-row">
              <span class="font-semibold text-foreground">Price</span>
              <span class="text-primary font-semibold text-right">{usd(PRICES.purification)} out the door</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Internal links / related -->
  <section class="bg-card py-12 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-serif mb-6 text-foreground">Related Pages</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/water-softener-utah/" class="related-link">Water Softener Utah</a>
        <a href="/whole-home-water-filtration/" class="related-link">Whole-Home Filtration</a>
        <a href="/water-softener-vs-whole-home-filtration/" class="related-link">Softener vs. Filtration vs. RO</a>
        <a href="/locations/salt-lake-city/" class="related-link">Salt Lake City Water Treatment</a>
        <a href="/utah-water-quality/" class="related-link">Utah Water Quality Guide</a>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-card py-16 md:py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <Reviews max={6} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-background py-16 md:py-20 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-serif text-center mb-10 text-foreground">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="faq-item group">
            <summary class="faq-question">
              {faq.question}
              <span class="faq-icon group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="faq-answer">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="bg-card py-12 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl font-serif mb-4 text-foreground">Serving the Wasatch Front</h2>
      <p class="text-muted-foreground mb-6">
        Blue Logic installs whole-home reverse osmosis systems across Utah's Wasatch Front,
        from Ogden to Springville and everywhere in between.
      </p>
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {["Salt Lake City", "Provo", "Orem", "Lehi", "Sandy", "Draper", "Ogden", "Layton", "Bountiful", "American Fork", "Spanish Fork", "Springville"].map((city) => (
          <span class="px-3 py-1 bg-background border border-border rounded-full text-sm text-muted-foreground">
            {city}
          </span>
        ))}
      </div>
      <a href="/locations/" class="text-primary font-semibold hover:opacity-80 transition-opacity">
        View all service areas →
      </a>
    </div>
  </section>

  <!-- Bottom CTA / Form -->
  <section class="bg-primary/5 py-16 md:py-20 px-4">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-serif text-center mb-4 text-foreground">
        Ready to Get Started?
      </h2>
      <p class="text-lg text-muted-foreground text-center mb-10">
        Schedule your free in-home water test. A Blue Logic specialist will test your water
        on-site and show you exactly what's in it. No cost, no obligation.
      </p>
      <LeadForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  .stage-card {
    @apply bg-background p-6 rounded-2xl border border-border text-center;
  }

  .stage-number {
    @apply w-12 h-12 bg-primary text-primary-foreground rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4;
  }

  .stage-badge {
    @apply inline-block text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full bg-primary/10 text-primary;
  }

  .stage-badge-purification {
    @apply bg-success/10 text-success;
  }

  .spec-row {
    @apply flex justify-between items-center gap-4 py-3 border-b border-border text-sm;
  }

  .related-link {
    @apply px-4 py-2 bg-background border border-border rounded-full text-sm text-primary font-medium hover:border-primary transition-colors;
  }

  .faq-item {
    @apply bg-card border border-border rounded-xl overflow-hidden;
  }

  .faq-question {
    @apply flex justify-between items-center p-6 cursor-pointer font-semibold text-foreground list-none select-none hover:bg-accent/50 transition-colors;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    @apply text-2xl text-primary font-light leading-none shrink-0;
  }

  .faq-answer {
    @apply px-6 pb-6 text-muted-foreground leading-relaxed;
  }
</style>
