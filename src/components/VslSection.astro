---
// "Meet Jared" owner video. Click-to-load facade: only a local poster image ships
// with the page; the YouTube iframe is created when the visitor presses play,
// so the video adds nothing to page weight or LCP. The transcript is real page
// text (inside <details>) for readers, search engines and AI answer engines.
// Pair with getVslSchema() from src/data/vsl.ts in the page's schema array.
import { Image } from "astro:assets";
import poster from "../assets/vsl/jared-owner-intro.jpg";
import { VSL, VSL_TRANSCRIPT } from "../data/vsl";

interface Props {
  heading?: string;
  intro?: string;
  ctaHref?: string;
  ctaLabel?: string;
  showCta?: boolean;
}

const {
  heading = "Meet Jared, One of Our Owners",
  intro = "A two-and-a-half-minute introduction to how we work: education first, a free test of your own water, and a system matched to what your home actually needs.",
  ctaHref = "/free-water-test/",
  ctaLabel = "Book Your Free Water Test",
  showCta = true,
} = Astro.props;
---

<section class="vsl-section bg-card py-16 md:py-24 px-4 md:px-8" aria-labelledby="vsl-heading">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8">
      <h2 id="vsl-heading" class="text-3xl md:text-4xl font-serif text-foreground mb-3">{heading}</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">{intro}</p>
    </div>

    <div class="vsl-player relative w-full aspect-video rounded-2xl overflow-hidden shadow-xl border border-border bg-black">
      <button
        type="button"
        class="vsl-play group absolute inset-0 w-full h-full cursor-pointer"
        data-youtube-id={VSL.youtubeId}
        aria-label={`Play video: ${VSL.title} (${VSL.durationLabel})`}
      >
        <Image
          src={poster}
          alt="Jared, co-owner of Blue Logic, speaking to the camera"
          widths={[640, 960, 1280]}
          sizes="(max-width: 896px) 100vw, 896px"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <span class="absolute inset-0 flex items-center justify-center">
          <span class="flex items-center justify-center w-20 h-20 rounded-full bg-primary text-primary-foreground shadow-lg transition-transform group-hover:scale-110 group-focus-visible:scale-110">
            <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
          </span>
        </span>
        <span class="absolute bottom-3 right-3 rounded-md bg-black/75 px-2 py-1 text-xs font-medium text-white">{VSL.durationLabel}</span>
      </button>
    </div>

    <details class="mt-6 rounded-xl border border-border bg-card p-5">
      <summary class="cursor-pointer font-semibold text-foreground">Read the video transcript</summary>
      <div class="mt-4 space-y-3 text-sm text-muted-foreground leading-relaxed">
        {VSL_TRANSCRIPT.map((p) => <p>{p}</p>)}
      </div>
    </details>

    {showCta && (
      <div class="mt-8 text-center">
        <a href={ctaHref} class="inline-block rounded-full bg-primary px-8 py-4 font-semibold text-primary-foreground shadow-lg transition hover:opacity-90">
          {ctaLabel}
        </a>
      </div>
    )}
  </div>
</section>

<script>
  function initVsl() {
    document.querySelectorAll<HTMLButtonElement>(".vsl-play").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const id = btn.dataset.youtubeId;
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&cc_load_policy=0`;
        iframe.title = btn.getAttribute("aria-label") || "Blue Logic video";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
        iframe.allowFullscreen = true;
        iframe.className = "absolute inset-0 w-full h-full";
        btn.replaceWith(iframe);
      });
    });
  }
  initVsl();
  document.addEventListener("astro:page-load", initVsl);
</script>
